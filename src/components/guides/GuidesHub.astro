---
/*
 * De hub /guides/ (Nutri, 10 oktober 2026; herschikt op 19 oktober 2026: "The
 * guides section is now 1 gigantic big mess", gekozen: tabs per categorie).
 *
 * Onder de korte inleiding uit guides.md: Onlangs bijgewerkt als één rij kleine
 * kaarten, dan een rij tabs met de categorieën en daaronder alleen de gekozen
 * categorie, als compacte rijen met een klein beeld, de naam, het levelbereik
 * en één regel uitleg. Alle categorieën staan in de HTML (een zoekmachine ziet
 * elke link); het script toont er één en zet de keuze in de hash (#dungeons).
 * Zonder JavaScript staan ze allemaal onder elkaar. De levelband van de
 * dungeons staat sinds 19 oktober 2026 op /guides/dungeons/ (DungeonBand.astro).
 *
 * De categorieën en kaarten staan in config/guides-hub.ts, de teksten in
 * i18n/guides-hub.ts.
 */
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';
import type { HubCard } from '../../config/guides-hub';
import { hubImageOf, hubModel, isExternalCard } from '../../lib/guides-hub';
import { hubBlurbs, hubT } from '../../i18n/guides-hub';
import { guideT } from '../../i18n/guides';
import { restedxpUrl } from '../../config/site';
import { pagePath } from '../../lib/pages';
import { isoDate, longDate } from '../../lib/date';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = hubT(locale);
const g = guideT(locale);
const blurbs = hubBlurbs[locale];

const imageOf = hubImageOf;

const { pageOf, categories, recent } = await hubModel(locale);

const isExternal = isExternalCard;
const hrefOf = (key: string) => (key.startsWith('/') ? `${localizePath(key, locale)}/` : pagePath(`guides/${key}`, locale));
const titleOf = (card: HubCard) => (card.label ? t(card.label) : pageOf(card.key)?.short ?? card.key);
const blurbOf = (card: HubCard) => blurbs[card.label === 'cardLeveling' ? 'leveling' : card.key.replace(/^\//, '')] ?? '';
const nameOf = (key: string) => t(`c_${key}` as Parameters<typeof t>[0]);

const guideCount = (cards: HubCard[]) =>
  cards.filter((card) => !isExternal(card)).reduce((sum, card) => sum + (card.parts?.length ?? 1), 0);
const first = categories[0]?.key;
---

<section class="wf-hub__block" aria-labelledby="wf-hub-recent" data-pagefind-ignore>
  <h2 class="wf-hub__title" id="wf-hub-recent">{t('recent')}</h2>
  <div class="wf-hub__recent">
    {recent.map(({ card, updated }) => {
      const image = imageOf(card.image);
      return (
        <a class="wf-hcard" href={hrefOf(card.key)}>
          <span class="wf-hcard__media">
            {image
              ? <Image src={image} alt="" widths={[240, 400]} sizes="(max-width: 600px) 45vw, 200px" loading="lazy" decoding="async" />
              : <span class="wf-hcard__stripes" aria-hidden="true"></span>}
          </span>
          <span class="wf-hcard__body">
            <span class="wf-hcard__name">{titleOf(card)}</span>
            <time class="wf-hcard__date" datetime={isoDate(updated)}>{t('updated', { date: longDate(updated, locale) })}</time>
          </span>
        </a>
      );
    })}
  </div>
</section>

<div class="wf-hub" data-wf-hub>
  <nav class="wf-hub__tabs" aria-label={t('categories')} data-pagefind-ignore>
    {categories.map((category) => {
      const n = category.external ? category.cards.length : guideCount(category.cards);
      return (
        <a
          class="wf-hub__tab"
          href={`#${category.key}`}
          data-tab={category.key}
          aria-current={category.key === first ? 'true' : undefined}
        >{nameOf(category.key)} <span class="wf-hub__n">{n}</span></a>
      );
    })}
  </nav>

  {categories.map((category) => (
    <section
      class="wf-hub__panel"
      id={category.key}
      data-panel={category.key}
      aria-labelledby={`wf-hub-${category.key}`}
      hidden={category.key !== first}
    >
      <h2 class="wf-hub__paneltitle" id={`wf-hub-${category.key}`}>{nameOf(category.key)}</h2>
      <ul class="wf-hub__rows">
        {category.cards.map((card) => {
          const image = imageOf(card.image);
          return (
            <li class="wf-hrow">
              <a class="wf-hrow__link" href={hrefOf(card.key)}>
                <span class="wf-hrow__media">
                  {image
                    ? <Image src={image} alt="" widths={[160, 240]} sizes="120px" loading="lazy" decoding="async" />
                    : <span class="wf-hcard__stripes" aria-hidden="true"></span>}
                </span>
                <span class="wf-hrow__body">
                  <span class="wf-hrow__top">
                    <span class="wf-hrow__name">{titleOf(card)}</span>
                    {card.isNew && <span class="wf-hrow__badge is-new">{t('new')}</span>}
                    {card.levels && <span class="wf-hrow__levels">{t('levels', { range: card.levels })}</span>}
                  </span>
                  <span class="wf-hrow__text">{blurbOf(card)}</span>
                </span>
              </a>
              {card.parts && (
                <span class="wf-hrow__parts">
                  {card.parts.filter((key) => pageOf(key)).map((key, index) => (
                    <a class="wf-gchip" href={hrefOf(key)}>{t('part', { n: index + 1 })}</a>
                  ))}
                </span>
              )}
            </li>
          );
        })}
      </ul>

      {category.key === 'leveling' && (
        <aside class="wf-rxpblock" data-pagefind-ignore>
          <p>{g('restedxpText')}</p>
          <a href={restedxpUrl} rel="noopener sponsored">{g('restedxpButton')}</a>
        </aside>
      )}
    </section>
  ))}
</div>

<noscript><style>.wf-hub__panel[hidden] { display: block !important; } .wf-hub__tabs { display: none; }</style></noscript>

<style>
  .wf-hub__block { margin-top: 30px; }
  .wf-hub__title { font-family: var(--wf-display); font-size: 20px; line-height: 1.2; color: var(--wf-ink); }

  .wf-hub__recent {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  /* Een kleine kaart onder Onlangs bijgewerkt. */
  .wf-hcard {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--wf-raised);
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-card-sm, 10px);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .wf-hcard:hover { border-color: var(--wf-accent-deep); box-shadow: var(--wf-glow-card); }
  .wf-hcard__media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--wf-slot-a); }
  .wf-hcard__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .wf-hcard__stripes {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(45deg, var(--wf-slot-a) 0 10px, var(--wf-slot-b) 10px 20px);
  }
  .wf-hcard__body { display: flex; flex-direction: column; gap: 3px; padding: 9px 11px 11px; }
  .wf-hcard__name { font-family: var(--wf-display); font-size: 14.5px; font-weight: 700; line-height: 1.25; color: var(--wf-ink); }
  .wf-hcard:hover .wf-hcard__name { color: var(--wf-accent); }
  .wf-hcard__date { font-size: 12px; color: var(--wf-label); }

  /* De tabs: een rij chips, op een telefoon horizontaal scrollbaar. */
  .wf-hub { margin-top: 30px; }
  .wf-hub__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--wf-border);
  }
  .wf-hub__tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-pill);
    font-size: 14px;
    color: var(--wf-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color .15s ease, color .15s ease, background-color .15s ease;
  }
  .wf-hub__tab:hover { border-color: var(--wf-accent-deep); color: var(--wf-ink); }
  .wf-hub__tab[aria-current='true'] {
    background: var(--wf-accent-wash);
    border-color: var(--wf-accent-deep);
    color: var(--wf-accent-bright);
  }
  .wf-hub__n { font-size: 12px; color: var(--wf-label); }
  .wf-hub__tab[aria-current='true'] .wf-hub__n { color: var(--wf-accent); }

  .wf-hub__panel { margin-top: 18px; }
  .wf-hub__panel[hidden] { display: none; }
  /* De kop zegt hetzelfde als de gekozen tab: alleen voor schermlezers en zonder JavaScript zichtbaar. */
  .wf-hub__paneltitle {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Een gids als rij: klein beeld, naam met levels, één regel uitleg. */
  .wf-hub__rows {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wf-hrow {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--wf-raised);
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-card-sm, 10px);
    overflow: hidden;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .wf-hrow:hover, .wf-hrow:focus-within { border-color: var(--wf-accent-deep); box-shadow: var(--wf-glow-card); }
  .wf-hrow__link { display: flex; align-items: center; gap: 12px; padding: 8px; color: inherit; text-decoration: none; }
  .wf-hrow__media {
    position: relative;
    flex: none;
    width: 112px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    background: var(--wf-slot-a);
  }
  .wf-hrow__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .wf-hrow__body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .wf-hrow__top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; }
  .wf-hrow__name { font-family: var(--wf-display); font-size: 15.5px; font-weight: 700; line-height: 1.25; color: var(--wf-ink); }
  .wf-hrow__link:hover .wf-hrow__name { color: var(--wf-accent); }
  .wf-hrow__levels { font-size: 12px; color: var(--wf-label); white-space: nowrap; }
  .wf-hrow__badge {
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .wf-hrow__badge.is-new { color: #1a1408; background: linear-gradient(180deg, #e0b77a, #c39449); }
  .wf-hrow__text {
    font-size: 13px;
    line-height: 1.4;
    color: var(--wf-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .wf-hrow__parts { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 8px 8px 132px; }
  .wf-hrow__parts .wf-gchip { font-size: 12px; padding: 2px 9px; }

  .wf-hub__panel .wf-rxpblock { margin-top: 16px; }

  @media (max-width: 760px) {
    /* Onlangs bijgewerkt als één rij om opzij te vegen, niet als een blok van een scherm hoog. */
    .wf-hub__recent {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: -16px;
      padding-inline: 16px;
    }
    .wf-hub__recent::-webkit-scrollbar { display: none; }
    .wf-hub__recent .wf-hcard { flex: none; width: 168px; scroll-snap-align: start; }
    .wf-hub__rows { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 599px) {
    .wf-hub__tabs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -16px; padding-inline: 16px; }
    .wf-hub__tabs::-webkit-scrollbar { display: none; }
    .wf-hub__tab { flex: none; }
    .wf-hrow__media { width: 88px; }
    .wf-hrow__parts { padding-left: 8px; }
  }

  /* Dag: zachtere rand en geen gloed (handoff §4.2). */
  :global(:root[data-theme="day"]) .wf-hcard:hover,
  :global(:root[data-theme="day"]) .wf-hrow:hover { box-shadow: 0 4px 14px rgba(27, 33, 54, .08); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-wf-hub]');

  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const keys = panels.map((panel) => panel.dataset.panel);

    const show = (key: string) => {
      panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== key; });
      tabs.forEach((tab) => {
        if (tab.dataset.tab === key) tab.setAttribute('aria-current', 'true');
        else tab.removeAttribute('aria-current');
      });
    };

    tabs.forEach((tab) => tab.addEventListener('click', (event) => {
      event.preventDefault();
      const key = tab.dataset.tab ?? '';
      show(key);
      // De keuze in de hash, zonder te springen: zo werkt terug en delen.
      history.replaceState(null, '', `#${key}`);
    }));

    const fromHash = () => {
      const key = window.location.hash.slice(1);
      if (keys.includes(key)) show(key);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>
