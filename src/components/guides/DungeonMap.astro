---
/*
 * De kaart van een dungeon bovenaan de tab Guide. De Forever-client heeft geen
 * dungeonkaarten; we tonen de perkamentkaart van Blizzard uit World of Warcraft waar de
 * indeling nog die van Forever is, met onze genummerde bazen erop (Nutri, 19 oktober
 * 2026: "Map with numbered bosses"). Eigen getekende kaarten zijn geschrapt (Nutri:
 * "the Hall of Thanes map is garbage"); zonder data toont dit niets.
 *
 * Data: data/dungeons/maps/<slug>.json, per verdieping een beeld uit
 * assets/dungeon-maps/ en de bazen als { n, x, y } in procenten van het beeld. Het
 * nummer is de plaats van de baas in de buit (lib/dungeons.ts), dus gelijk aan de subtabs.
 * De posities komen van de kaarten van Wowhead (retail) en zijn met het oog nagekeken.
 */
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/ui';
import { dungeonT } from '../../i18n/dungeon';
import type { DungeonData } from '../../lib/dungeons';

type MapData = {
  floors: { image: string; label?: string; markers: { n: number; x: number; y: number }[] }[];
};

interface Props {
  locale: Locale;
  slug: string;
  data: DungeonData;
}

const { locale, slug, data } = Astro.props;
const t = dungeonT(locale);
const maps = import.meta.glob<MapData>('../../data/dungeons/maps/*.json', { eager: true, import: 'default' });
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/dungeon-maps/*.jpg', { eager: true });
const map = maps[`../../data/dungeons/maps/${slug}.json`];
const image = (file: string) => images[`../../assets/dungeon-maps/${file}`]?.default;
const floors = (map?.floors ?? []).filter((f) => image(f.image));
const several = floors.length > 1;
---

{floors.length > 0 && (
  <figure class:list={['wf-dmap', { 'is-floors': several }]}>
    <div class="wf-dmap__floors">
      {floors.map((f) => (
        <div class="wf-dmap__floor">
          {several && f.label && <p class="wf-dmap__label">{f.label}</p>}
          <div class="wf-dmap__img">
            <Image src={image(f.image)!} alt={t('mapTitle')} widths={[500, 1000]} sizes={several ? '(max-width: 700px) 100vw, 460px' : '(max-width: 800px) 100vw, 760px'} loading="lazy" />
            {f.markers.map((m) => (
              <span class="wf-dmap__pin" style={`left:${m.x}%;top:${m.y}%`} title={data.bosses[m.n - 1]?.name}>{m.n}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
    <figcaption class="wf-dmap__legend">
      {data.bosses.map((b, i) => <span><i class="wf-dmap__key" aria-hidden="true">{i + 1}</i>{b.name}</span>)}
      <span class="wf-dmap__note">{t('mapBlizzard')}</span>
    </figcaption>
  </figure>
)}

<style>
  .wf-dmap {
    margin: 0 0 22px;
    padding: 12px;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-card);
    background: var(--wf-raised);
  }
  .wf-dmap__floors { display: grid; gap: 12px; }
  .wf-dmap:not(.is-floors) { width: fit-content; max-width: 100%; }
  .wf-dmap:not(.is-floors) .wf-dmap__floors { max-width: 760px; }
  .wf-dmap:not(.is-floors) .wf-dmap__legend { max-width: 760px; }
  .is-floors .wf-dmap__floors { grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .wf-dmap__label { margin: 0 0 4px; font-family: var(--wf-display); font-size: 13px; color: var(--wf-muted); letter-spacing: .04em; }
  .wf-dmap__img { position: relative; line-height: 0; }
  .wf-dmap__img img { display: block; width: 100%; height: auto; border-radius: var(--wf-r-card-sm); }
  .wf-dmap__pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border: 2px solid #1b1410;
    border-radius: 50%;
    background: var(--wf-accent);
    color: #1b1410;
    font: 700 12px/1 var(--wf-display);
    box-shadow: 0 1px 3px rgba(0, 0, 0, .5);
  }

  .wf-dmap__legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 12px; font-size: 14px; color: var(--wf-ink); }
  .wf-dmap__legend span { display: inline-flex; align-items: center; gap: 6px; }
  .wf-dmap__key {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    font-style: normal;
    font-family: var(--wf-display);
    font-size: 11px;
    font-weight: 700;
    color: var(--wf-bg);
    background: var(--wf-accent);
  }
  .wf-dmap__note { flex-basis: 100%; font-size: 12.5px; color: var(--wf-muted); }
</style>
