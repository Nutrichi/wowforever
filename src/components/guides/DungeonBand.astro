---
/*
 * De levelband van alle dungeons van 9 tot 60: elke dungeon als balk op een
 * schaal van level 1 tot 60, goud als er een gids is. Stond tot 19 oktober 2026
 * op de hub /guides/ en staat nu op het dungeonoverzicht /guides/dungeons/
 * (Nutri: de hub was veel te lang).
 */
import type { Locale } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';
import { hubDungeons } from '../../config/guides-hub';
import { hubModel } from '../../lib/guides-hub';
import { hubT } from '../../i18n/guides-hub';
import { pagePath } from '../../lib/pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = hubT(locale);
const { pageOf } = await hubModel(locale);
const hrefOf = (key: string) => (key.startsWith('/') ? `${localizePath(key, locale)}/` : pagePath(`guides/${key}`, locale));

// De schaal begint bij het tiental onder de laagste dungeon, niet bij level 1:
// anders stond de linkerhelft leeg (Nutri, 19 oktober 2026). Gesorteerd op
// level, zodat de balken een trap vormen.
const dungeons = [...hubDungeons].sort((a, b) => a.min - b.min || a.max - b.max);
const lowest = Math.min(...dungeons.map((d) => d.min));
const scaleMin = Math.floor(lowest / 10) * 10;
const scaleMax = 60;
const pct = (level: number) => ((level - scaleMin) / (scaleMax - scaleMin)) * 100;
const ticks = Array.from({ length: (scaleMax - scaleMin) / 5 + 1 }, (_, i) => scaleMin + i * 5);
---

<div class="wf-band">
  <h2 class="wf-band__title">{t('bandTitle')}</h2>
  <p class="wf-band__intro">{t('bandIntro', { n: dungeons.length, min: lowest })}</p>
  <p class="wf-band__legend" aria-hidden="true">
    <span><i class="wf-band__swatch is-guide"></i>{t('bandLegendGuide')}</span>
    <span><i class="wf-band__swatch"></i>{t('bandLegendSoon')}</span>
    <span><i class="wf-band__dot"></i>{t('bandLegendNew')}</span>
  </p>
  <div class="wf-band__chart">
    <div class="wf-band__grid" aria-hidden="true">
      {ticks.map((tick) => <span class:list={['wf-band__line', { 'is-major': tick % 10 === 0 }]} style={`left:${pct(tick)}%`}></span>)}
    </div>
    <ol class="wf-band__list">
      <li class="wf-band__scale" aria-hidden="true">
        <span class="wf-band__name"></span>
        <span class="wf-band__track">
          {ticks.filter((tick) => tick % 10 === 0).map((tick) => (
            <span class:list={['wf-band__tick', { 'is-first': tick === scaleMin, 'is-last': tick === scaleMax }]} style={`left:${pct(tick)}%`}>{tick}</span>
          ))}
        </span>
      </li>
      {dungeons.map((dungeon) => {
        const hasGuide = dungeon.key && pageOf(dungeon.key);
        const range = `${dungeon.min}-${dungeon.max}`;
        const style = `left:${pct(dungeon.min)}%;width:${pct(dungeon.max) - pct(dungeon.min)}%`;
        // Het bereik staat rechts van de balk, of links als de balk tot aan de rand loopt.
        const labelStyle = dungeon.max >= 55 ? `right:calc(${100 - pct(dungeon.min)}% + 8px)` : `left:calc(${pct(dungeon.max)}% + 8px)`;
        return (
          <li class:list={['wf-band__row', { 'has-guide': hasGuide }]}>
            <span class="wf-band__name">
              {hasGuide ? <a href={hrefOf(dungeon.key!)}>{dungeon.name}</a> : <span>{dungeon.name}</span>}
              {dungeon.isNew && <i class="wf-band__dot" title={t('bandLegendNew')}><span class="wf-sr">{t('new')}</span></i>}
              <span class="wf-band__meta">{range}{!hasGuide && <> · {t('bandSoon')}</>}</span>
            </span>
            <span class="wf-band__track">
              <span class="wf-band__bar" style={style}></span>
              <span class="wf-band__range" style={labelStyle}>{range}</span>
            </span>
          </li>
        );
      })}
    </ol>
  </div>
</div>

<style>
  /* De levelband: elke dungeon als balk op een schaal van level 1 tot 60. */
  .wf-band {
    margin: 8px 0 28px;
    padding: 16px 18px 18px;
    background: var(--wf-raised-soft);
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-card-sm, 10px);
  }
  .wf-band__title { margin: 0; font-family: var(--wf-display); font-size: 17px; color: var(--wf-ink); }
  .wf-band__intro { margin-top: 6px; font-size: 14px; color: var(--wf-muted); }
  .wf-band__legend { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 10px; font-size: 12.5px; color: var(--wf-label); }
  .wf-band__legend > span { display: inline-flex; align-items: center; gap: 6px; }
  .wf-band__swatch { display: inline-block; width: 18px; height: 6px; border-radius: 3px; background: var(--wf-muted-dim); }
  .wf-band__swatch.is-guide { background: linear-gradient(90deg, #f0cd97, #e0b77a, #b5872f); }
  .wf-band__dot {
    display: inline-block;
    flex: none;
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: var(--wf-arcane);
  }

  /* De kolom met namen is vast; de rest is de schaal, met lijnen per 5 levels. */
  .wf-band__chart { --wf-band-name: 220px; --wf-band-gap: 16px; position: relative; margin-top: 14px; }
  .wf-band__grid {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--wf-band-name) + var(--wf-band-gap));
    right: 0;
    pointer-events: none;
  }
  .wf-band__line { position: absolute; top: 22px; bottom: 0; width: 1px; background: rgba(35, 48, 79, .45); }
  .wf-band__line.is-major { background: rgba(35, 48, 79, .9); }

  .wf-band__list { position: relative; list-style: none; margin: 0; padding: 0; }
  .wf-band__row, .wf-band__scale {
    display: grid;
    grid-template-columns: var(--wf-band-name) 1fr;
    align-items: center;
    gap: var(--wf-band-gap);
    min-height: 30px;
  }
  .wf-band__row { border-radius: 6px; transition: background .15s ease; }
  .wf-band__row:hover { background: rgba(224, 183, 122, .06); }
  .wf-band__name { display: inline-flex; align-items: center; gap: 7px; min-width: 0; padding-left: 6px; font-size: 13.5px; color: var(--wf-label); }
  .wf-band__name > a, .wf-band__name > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wf-band__row.has-guide .wf-band__name a { color: var(--wf-ink); font-weight: 600; text-decoration: none; }
  .wf-band__row.has-guide .wf-band__name a:hover { color: var(--wf-accent); }

  .wf-band__track { position: relative; height: 30px; }
  .wf-band__scale .wf-band__track { height: 22px; }
  .wf-band__tick {
    position: absolute;
    top: 2px;
    transform: translateX(-50%);
    font-size: 11px;
    color: var(--wf-label);
  }
  .wf-band__tick.is-first { transform: none; }
  .wf-band__tick.is-last { transform: translateX(-100%); }
  .wf-band__bar {
    position: absolute;
    top: 11px;
    height: 8px;
    min-width: 8px;
    border-radius: 4px;
    background: var(--wf-muted-dim);
    opacity: .75;
  }
  .wf-band__row.has-guide .wf-band__bar {
    background: linear-gradient(90deg, #f0cd97, #e0b77a, #b5872f);
    opacity: 1;
    box-shadow: 0 0 10px rgba(224, 183, 122, .25);
  }
  .wf-band__range {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    color: var(--wf-label);
    white-space: nowrap;
    pointer-events: none;
  }
  .wf-band__row:hover .wf-band__range { color: var(--wf-ink); }

  .wf-band__meta { display: none; }

  /* Op een telefoon: naam en bereik op een regel, de balk eronder over de volle breedte. */
  @media (max-width: 599px) {
    .wf-band { padding: 14px 12px 14px; }
    .wf-band__chart { --wf-band-name: 0px; --wf-band-gap: 0px; }
    .wf-band__row, .wf-band__scale { grid-template-columns: 1fr; gap: 3px; padding: 5px 0; }
    .wf-band__scale .wf-band__name { display: none; }
    .wf-band__name { padding-left: 0; }
    .wf-band__meta { display: inline; margin-left: auto; padding-left: 8px; font-size: 11.5px; color: var(--wf-label); white-space: nowrap; }
    .wf-band__range { display: none; }
    .wf-band__line { display: none; }
    .wf-band__row .wf-band__track { height: 8px; }
    .wf-band__row .wf-band__bar { top: 0; }
  }

  :global(:root[data-theme="day"]) .wf-band__line { background: #f3e9df; }
  :global(:root[data-theme="day"]) .wf-band__line.is-major { background: #e6d6c6; }
</style>
