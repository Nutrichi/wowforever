---
/*
 * Eén losse pagina buiten de zeven secties (PROJECT_SPEC.md §4.4, fase 5): de
 * hub /forever/, een levelroute onder /routes/, een vergelijking onder
 * /compare/ of een gids onder /guides/. Hier landt zoekverkeer, dus alles staat in de HTML.
 *
 * Van boven naar onder: broodkruimel, titel, de datum van de laatste
 * controle, chips naar de verwante pagina's (de andere routes of de andere
 * vergelijkingen), de tekst uit de Markdown, de vragen uit de frontmatter,
 * bij routes en vergelijkingen het RestedXP-blok (op drie vergelijkingen met
 * een Zygor-blok eronder, `zygorPages`), en de bronregel.
 *
 * De vragen staan ook als FAQPage in de JSON-LD. Het codewoord Camelot staat
 * alleen in de vragen van de hub (§4.4).
 */
import { render } from 'astro:content';
import type { Locale } from '../../i18n/ui';
import { localeTags } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/utils';
import { isPartnerLink, restedxpPages, zygorPages } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage, getPages, pagePath } from '../../lib/pages';
import { pageT } from '../../i18n/pages';
import { guideT } from '../../i18n/guides';
import GuidesHub from '../guides/GuidesHub.astro';
import ForeverTimeline from './ForeverTimeline.astro';
import DungeonBand from '../guides/DungeonBand.astro';
import PartnerBlock from '../PartnerBlock.astro';
import DungeonPage from '../guides/DungeonPage.astro';
import TradeskillNav from '../tradeskills/TradeskillNav.astro';
import { tsData } from '../../lib/tradeskills-forever';
import { hubCategories } from '../../config/guides-hub';
import { breadcrumbJsonLd, publisherJsonLd } from '../../lib/structured-data';
import { isoDate, longDate } from '../../lib/date';
import '../../styles/guides.css';

interface Props {
  locale: Locale;
  pageKey: string;
}

const { locale, pageKey } = Astro.props;
const page = await getPage(pageKey, locale);

// Kan niet gebeuren: de sleutel komt uit dezelfde lijst. Faalt hij toch, dan faalt de build luid.
if (!page) throw new Error(`Onbekende pagina: ${pageKey}`);

const { Content } = await render(page.entry);
const t = pageT(locale);
const g = guideT(locale);
const ui = useTranslations(locale);

const folder = pageKey.split('/')[0];
const inGroup = folder === 'routes' || folder === 'compare';
// Chips naar de verwante pagina's: de routes, de vergelijkingen, sinds 26 september 2026 de gidsen,
// en sinds 29 september 2026 de Forever-gidsen onder TRADESKILLS (tradeskills/forever/<skill>).
const hasChips = inGroup || folder === 'guides' || folder === 'tradeskills';
const all = await getPages(locale);
/*
 * Een groep binnen een map (28 september 2026): de dungeongidsen staan onder
 * /guides/dungeons/. Op zo'n pagina, en op /guides/dungeons/ zelf, tonen de
 * chips die groep; elders in de map alleen de pagina's van het eerste niveau.
 */
const parts = pageKey.split('/');
const depth = (key: string) => key.split('/').length;
const hasChildren = (key: string) => all.some((other) => other.key.startsWith(`${key}/`));
// Een dungeon in drie tabs (19 oktober 2026): de chips tonen de andere dungeons, niet de tabs.
const dungeon = page.entry.data.dungeon;
const groupKey = dungeon
  ? 'guides/dungeons'
  : depth(pageKey) >= 3
    ? pageKey.split('/').slice(0, -1).join('/')
    : depth(pageKey) === 2 && hasChildren(pageKey) ? pageKey : null;
/*
 * Een grote groep (30 september 2026, de petgidsen: meer dan negentig pagina's)
 * krijgt geen rij chips met elke pagina; daar staan de chips van het eerste
 * niveau, en de tabel op het overzicht en de broodkruimel wijzen de weg.
 */
const maxGroupChips = 20;
const groupMembers = groupKey
  ? all.filter((other) => other.key === groupKey || (other.key.startsWith(`${groupKey}/`) && depth(other.key) === depth(groupKey) + 1))
  : [];
/*
 * Bij de gidsen (19 oktober 2026, Nutri: "This is messy"): geen rij met alle
 * gidsen op alfabet meer, maar alleen de gidsen uit dezelfde categorie van de
 * hub (config/guides-hub.ts). De hub zelf heeft zijn tabs en geen chips.
 */
const top = parts[1];
const category = folder === 'guides' && top
  ? hubCategories.find((cat) => cat.cards.some((card) => card.key === top || card.key.startsWith(`${top}/`)))
  : undefined;
const categoryMembers = category
  ? category.cards
    .filter((card) => !card.key.startsWith('/'))
    .map((card) => all.find((other) => other.key === `guides/${card.parts?.[0] ?? card.key}`))
    .filter((other): other is (typeof all)[number] => !!other)
  : [];
// Een Forever-tradeskill toont de twaalf tradeskills en zijn tabs (TradeskillNav), geen chips.
const tsSkill = pageKey.startsWith('tradeskills/forever/') ? pageKey.split('/')[2] : '';
const members = !hasChips || pageKey === 'guides' || (tsSkill && tsData(tsSkill)) ? []
  : groupKey && groupMembers.length <= maxGroupChips
    ? groupMembers
    : folder === 'guides'
      ? categoryMembers
      : all.filter((other) => (other.key === folder || other.key.startsWith(`${folder}/`)) && depth(other.key) <= 2);

const crumbs = [{ name: ui('crumb.home'), path: localizePath('', locale) }];
if (folder === 'routes' && pageKey !== 'routes' && all.some((other) => other.key === 'routes')) {
  crumbs.push({ name: t('routesCrumb'), path: pagePath('routes', locale) });
}
// /forever/ hoort sinds 19 oktober 2026 bij de gidsen (Nutri); het adres blijft, want daar wijzen 90 pagina's naar.
if ((folder === 'guides' || pageKey === 'forever') && pageKey !== 'guides' && all.some((other) => other.key === 'guides')) {
  crumbs.push({ name: ui('nav.guides'), path: pagePath('guides', locale) });
}
if (folder === 'tradeskills') {
  crumbs.push({ name: ui('nav.tradeskills'), path: pagePath('tradeskills', locale) });
}
// Tussenliggende pagina's, zoals Dungeons tussen Gidsen en een dungeon.
for (let i = 2; i < parts.length; i++) {
  const parent = all.find((other) => other.key === parts.slice(0, i).join('/'));
  if (parent) crumbs.push({ name: parent.short, path: parent.href });
}
crumbs.push({ name: page.short, path: page.href });

const hideSources = folder === 'guides' || folder === 'tradeskills' || pageKey === 'forever';
const canonical = new URL(page.href, Astro.site ?? 'https://wowforever.be').href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbJsonLd(crumbs, Astro.site),
    {
      '@type': 'Article',
      headline: page.metaTitle,
      description: page.description,
      dateModified: isoDate(page.updated),
      inLanguage: localeTags[page.lang],
      mainEntityOfPage: canonical,
      author: publisherJsonLd(Astro.site),
      publisher: publisherJsonLd(Astro.site),
    },
    ...(page.faq.length
      ? [{
        '@type': 'FAQPage',
        mainEntity: page.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }]
      : []),
  ],
};
---

<BaseLayout locale={locale} title={page.metaTitle} description={page.description} ogType="article">
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />

  <article class="wf-gdetail wf-page" data-pagefind-body data-pagefind-meta={`title:${page.metaTitle}`}>
    <nav class="wf-gcrumb" aria-label={ui('crumb.label')} data-pagefind-ignore>
      {crumbs.slice(0, -1).map((crumb) => (
        <>
          <a href={crumb.path}>{crumb.name}</a>
          <span aria-hidden="true">/</span>
        </>
      ))}
      <span>{page.short}</span>
    </nav>

    <header class="wf-gdetail__head">
      <span class="wf-gdetail__diamond" style="--wf-diamond: #e0b77a;" aria-hidden="true"></span>
      <div>
        <h1 class="wf-gdetail__title">{page.title}</h1>
        {/* Geen datum onder de titel in de gidsen (19 oktober 2026, Nutri: "Useless"). De datum blijft in de JSON-LD. */}
        {folder !== 'guides' && (
          <p class="wf-gdetail__meta">
            <time datetime={isoDate(page.updated)}>{t('updated', { date: longDate(page.updated, locale) })}</time>
          </p>
        )}
      </div>
    </header>

    {members.length > 1 && (
      <nav class="wf-gchips" aria-label={t('otherPages')} data-pagefind-ignore>
        {members.map((other) => (
          <a class="wf-gchip" href={other.href} aria-current={other.key === page.key || (dungeon && other.key === `guides/dungeons/${dungeon.slug}`) ? 'page' : undefined}>{other.short}</a>
        ))}
      </nav>
    )}

    {tsSkill && tsData(tsSkill) && <TradeskillNav locale={locale} skill={tsSkill} current="overview" />}

    {/* De tijdlijn van Forever, van de beta tot de zomer van 2027 (19 oktober 2026). */}
    {pageKey === 'forever' && <ForeverTimeline locale={locale} />}

    {/* De levelband van alle dungeons, sinds 19 oktober 2026 hier en niet meer op de hub. */}
    {pageKey === 'guides/dungeons' && <DungeonBand locale={locale} />}

    {dungeon
      ? <DungeonPage locale={locale} slug={dungeon.slug} tab={dungeon.tab}><Content /></DungeonPage>
      : pageKey !== 'guides' && (
        <div class="wf-gprose">
          <Content />
        </div>
      )}

    {/* De hub /guides/ toont onder de inleiding kaarten per categorie (10 oktober 2026). */}
    {pageKey === 'guides' && <GuidesHub locale={locale} />}

    {page.faq.length > 0 && (
      <section class="wf-gprose wf-page__faq" aria-labelledby="wf-faq">
        <h2 id="wf-faq">{t('faqTitle')}</h2>
        {page.faq.map((item) => (
          <>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </>
        ))}
      </section>
    )}

    {(inGroup || restedxpPages.includes(page.key)) && (
      <PartnerBlock locale={locale} partner="restedxp" />
    )}

    {/* Journey onder RestedXP, op dezelfde pagina's (Nutri, 19 oktober 2026). */}
    {(inGroup || restedxpPages.includes(page.key)) && (
      <PartnerBlock locale={locale} partner="journey" next />
    )}

    {zygorPages.includes(page.key) && (
      <PartnerBlock locale={locale} partner="zygor" next />
    )}

    {/*
      * Geen bronregel op de gidsen, de tradeskills en /forever/ (19 oktober 2026, Nutri:
      * "take away any "source" in all of the pages in the guides section"). De bronnen
      * blijven in de frontmatter staan, zodat we intern weten waar alles vandaan komt.
      */}
    {page.sources.length > 0 && !hideSources && (
      <p class="wf-page__source" data-pagefind-ignore>
        {t('sources')}{' '}
        {page.sources.map((source, index) => (
          <>
            {index > 0 && ', '}
            <a
              href={source.url}
              rel={isPartnerLink(source.url) ? 'noopener sponsored' : 'noopener nofollow'}
              target="_blank"
            >{source.name}</a>
          </>
        ))}
      </p>
    )}
  </article>
</BaseLayout>

<style>
  .wf-page__faq { margin-top: 34px; }

  /*
   * De bronregel zoals bij een post (§7.1): gedempt, en pas bij hover blijkt
   * dat de namen links zijn.
   */
  .wf-page__source {
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid var(--wf-border);
    font-size: 13.5px;
    color: var(--wf-muted);
  }

  .wf-page__source a { color: inherit; }
  .wf-page__source a:hover { text-decoration: underline; }
</style>

<script>
  // Een video in een gids speelt pas na een klik, net als in een post (guides.css).
  import '../../scripts/post-video';
  // Beelden in de tekst groot bekijken, net als in een post (18 oktober 2026).
  import '../../scripts/guide-lightbox';
</script>
