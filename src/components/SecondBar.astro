---
/*
 * De tweede balk onder de header (handoff §6.3), op elke pagina.
 *
 * Van links naar rechts: de aftelchip naar de launch van WoW Forever, een
 * dunne lijn, de slot (daar komt de era-schakelaar op BIS, CLASSES,
 * TRADESKILLS en REPUTATIONS), en rechts het zoekveld, de Ko-fi-pil (sinds
 * 25 september 2026), de LIVE-knop (alleen als Nutri live is op YouTube, sinds
 * 17 oktober 2026) en de RestedXP-pil.
 *
 * **Zoeken stond eerst in de header** en is hier naartoe gegaan (Nutri,
 * 18 september 2026), zodat de navigatie de volle breedte houdt. Onder 900 px
 * blijft het hier weg: daar zit zoeken in het mobiele menu, en twee zoekvelden
 * op één scherm is er een te veel.
 *
 * De aftelchip staat bewust op zichzelf: na de launch is hij het eerste dat
 * vervangen wordt, zonder de rest van de balk aan te raken. Hij tikt per
 * minuut en klemt op nul. Zodra de hub `/forever/` bestaat, is hij daar de
 * ingang naartoe (PROJECT_SPEC.md §4.4); tot dan is het gewone tekst.
 *
 * Onder 1160 px staat de slot bovenaan de pagina zelf (BaseLayout), zodat de
 * balk op elke pagina even hoog is; onder 900 px blijven chip en pil daarbij
 * op één regel.
 */
import type { Locale } from '../i18n/ui';
import KofiPill from './KofiPill.astro';
import LivePill from './LivePill.astro';
import RestedXpPill from './RestedXpPill.astro';
import SearchField from './SearchField.astro';
import TimerChips from './TimerChips.astro';

interface Props {
  locale: Locale;
  /** Of een pagina iets in de slot zet. Zonder slot krijgt de RestedXP-pil de brede vorm. */
  hasContent?: boolean;
}

const { locale, hasContent = false } = Astro.props;
/* De aftelchip zit sinds 9 november 2026 in TimerChips (raids, reset en Darkmoon Faire). */
---

<div class="wf-bar">
  <div class:list={['wf-bar__inner', { 'has-content': hasContent }]}>
    <TimerChips locale={locale} />

    {hasContent && <span class="wf-bar__rule" aria-hidden="true"></span>}

    {hasContent && <div class="wf-bar__slot"><slot /></div>}

    <div class="wf-bar__right">
      <div class="wf-bar__search"><SearchField locale={locale} variant="bar" /></div>
      <KofiPill locale={locale} variant="bar" />
      <LivePill locale={locale} />
      <RestedXpPill locale={locale} wide />
    </div>
  </div>
</div>

<style>
  .wf-bar {
    background: var(--wf-bar);
    border-top: 1px solid var(--wf-border);
    border-bottom: 1px solid var(--wf-border);
  }

  .wf-bar__inner {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: var(--wf-max);
    margin: 0 auto;
    padding: 8px 26px;
    min-height: 49px;
  }

  .wf-bar__rule {
    flex: none;
    width: 1px;
    height: 22px;
    background: var(--wf-border);
  }

  /* De slot houdt de breedte van zijn inhoud (de era-rij); wat moet wijken,
     is het zoekveld rechts. Eerder krompen slot noch rechtergroep, en schoof
     het zoekveld over de laatste era-tab (gemeten 25 september 2026: vanaf
     900 tot 1180 px, en in het Frans op elke breedte). */
  .wf-bar__slot {
    flex: none;
    display: flex;
    align-items: center;
  }

  .wf-bar__right {
    flex: 1 1 auto;
    min-width: 0;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  /* Breed genoeg om een titel in te typen, smal genoeg om de balk niet te
     laten groeien. Krimpt tot 120 px zodra de slot ernaast ruimte vraagt. */
  .wf-bar__search {
    flex: 0 1 clamp(160px, 22vw, 260px);
    min-width: 120px;
  }

  /* Met een era-rij in de balk staat Ko-fi er als kopje zonder woord. */
  .has-content :global(.wf-kofi__label) { display: none; }
  .has-content :global(.wf-kofi) { padding: 5px 8px; }

  /* Van 900 tot 1159 px vullen de chip en de era-rij de balk al alleen, en
     schoof het zoekveld eroverheen (gemeten 25 en 28 september 2026; in het
     Frans tot 1130 px, in het Spaans tot 1120). Daar staat de
     era-rij nu bovenaan de pagina, zoals op mobiel (Nutri, 28 september 2026);
     de balk houdt chip, zoekveld, Ko-fi en RestedXP. Het breekpunt staat ook
     in global.css bij .wf-barline. */
  @media (min-width: 900px) and (max-width: 1159px) {
    .has-content .wf-bar__rule,
    .has-content .wf-bar__slot { display: none; }

    .has-content :global(.wf-kofi__label) { display: inline; }
    .has-content :global(.wf-kofi) { padding: 5px 12px 5px 10px; }
  }

  @media (max-width: 899px) {
    .wf-bar__inner {
      flex-wrap: wrap;
      gap: 8px 10px;
      padding: 8px 16px;
    }

    .wf-bar__rule { display: none; }

    /* De slot staat op mobiel bovenaan de pagina (BaseLayout). */
    .wf-bar__slot { display: none; }

    /* Zoeken zit op mobiel in het menu achter de hamburger. */
    .wf-bar__search { display: none; }
  }
</style>
