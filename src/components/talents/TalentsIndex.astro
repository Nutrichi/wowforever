---
/*
 * TOOLS op /talents/ (Nutri, 11 oktober 2026: de tab TALENTS heet Tools): vier grote
 * tegels, voor de talentcalculator, de Legacy-calculator, de raidplanner en de
 * levelbuilds. Elke tegel is in zijn geheel een link.
 *
 * De tegel van de talenten draagt ook de negen classes, elk in zijn eigen kleur, zodat
 * je met één klik in de juiste boom zit; de tegel zelf opent Druid, de eerste in het
 * alfabet (AFSPRAKEN.md §22 van de app). De classes liggen boven de link van de tegel.
 * De tegel van de levelbuilds draagt op dezelfde manier de classes met een build
 * (Nutri, 11 oktober 2026).
 *
 * Onder de vier staat de kaart van de iOS-app, zodra `appStoreUrl` in `config/site.ts`
 * gevuld is.
 */
import type { Locale } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { talT } from '../../i18n/talents';
import { talentClasses, totalTalentPoints, legacySpendable, clientBuild } from '../../lib/talents';
import { breadcrumbJsonLd } from '../../lib/structured-data';
import { levT } from '../../i18n/leveling';
import { levelingBuilds } from '../../lib/leveling';
import { raidT } from '../../i18n/raid';
import { appStoreUrl } from '../../config/site';
import '../../styles/talents.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = talT(locale);
const ui = useTranslations(locale);
const classes = talentClasses();
const base = localizePath('talents', locale);
const lev = levT(locale);
const raid = raidT(locale);
const first = classes[0]?.id ?? 'druid';
const levBase = localizePath('leveling', locale);
const levBuilds = levelingBuilds();
const levClasses = classes.filter((klass) => levBuilds.some((b) => b.id === klass.id));

const crumbs = [
  { name: ui('crumb.home'), path: localizePath('', locale) },
  { name: ui('nav.talents'), path: `${base}/` },
];
const jsonLd = { '@context': 'https://schema.org', ...breadcrumbJsonLd(crumbs, Astro.site) };
---

<BaseLayout locale={locale} title={t('toolsMetaTitle')} description={t('toolsDescription')}>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="wf-talents">
    <header class="wf-ghead">
      <div class="wf-ghead__main">
        <h1 class="wf-ghead__title">{t('toolsTitle')}</h1>
      </div>
    </header>

    <div class="wf-calccards wf-tooltiles">
      <section class="wf-calccard wf-tooltile">
        <img class="wf-tooltile__icon" src="/icons/inv_misc_book_11.jpg" alt="" width="56" height="56" />
        <h2 class="wf-calccard__title"><a class="wf-tooltile__link" href={`${base}/${first}/`}>{t('talentCard')}</a></h2>
        <p class="wf-calccard__text">{t('talentCardText')}</p>
        <ul class="wf-classlist wf-tooltile__classes">
          {classes.map((entry) => (
            <li>
              <a class="wf-classpill" href={`${base}/${entry.id}/`} data-class={entry.id}>
                <span class="wf-classpill__diamond" aria-hidden="true"></span>
                <span class="wf-classpill__name">{entry.name}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="wf-calccard__meta">{totalTalentPoints()} {t('points')}</p>
      </section>

      <section class="wf-calccard wf-tooltile">
        <img class="wf-tooltile__icon" src="/icons/spell_arcane_mindmastery.jpg" alt="" width="56" height="56" />
        <h2 class="wf-calccard__title"><a class="wf-tooltile__link" href={`${base}/legacy/`}>{t('legacyCard')}</a></h2>
        <p class="wf-calccard__text">{t('legacyCardText')}</p>
        <p class="wf-calccard__meta">{legacySpendable()} {t('points')}</p>
      </section>

      <section class="wf-calccard wf-tooltile">
        <img class="wf-tooltile__icon" src="/icons/ability_warrior_battleshout.jpg" alt="" width="56" height="56" />
        <h2 class="wf-calccard__title"><a class="wf-tooltile__link" href={`${localizePath('raid', locale)}/`}>{raid('switch')}</a></h2>
        <p class="wf-calccard__text">{t('raidCardText')}</p>
        <p class="wf-calccard__meta">5 · 10 · 20 · 40</p>
      </section>

      <section class="wf-calccard wf-tooltile">
        <img class="wf-tooltile__icon" src="/icons/spell_nature_swiftness.jpg" alt="" width="56" height="56" />
        <h2 class="wf-calccard__title"><a class="wf-tooltile__link" href={`${levBase}/`}>{lev('switch')}</a></h2>
        <p class="wf-calccard__text">{t('levelingCardText')}</p>
        <ul class="wf-classlist wf-tooltile__classes">
          {levClasses.map((entry) => (
            <li>
              <a class="wf-classpill" href={`${levBase}/${entry.id}/`} data-class={entry.id}>
                <span class="wf-classpill__diamond" aria-hidden="true"></span>
                <span class="wf-classpill__name">{entry.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {appStoreUrl !== '' && (
        <section class="wf-calccard wf-calccard--app">
          <h2 class="wf-calccard__title">{t('appCard')}</h2>
          <p class="wf-calccard__text">{t('appCardText')}</p>

          <a class="wf-btn wf-btn--primary" href={appStoreUrl} rel="noopener" target="_blank">
            {t('appCardButton')}
          </a>
        </section>
      )}
    </div>

    <p class="wf-talents__source">{t('source', { build: clientBuild() })}</p>
  </div>
</BaseLayout>
