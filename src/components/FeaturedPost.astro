---
/*
 * Het uitgelichte artikel, links op de homepage (§5). Eén artikel, groot,
 * dat niet doorrolt: een carousel blijft verboden.
 *
 * Beeld met het categorielabel erover, dan de titel, de samenvatting en een
 * metaregel met de datum en het hartje. Beeld én titel wijzen naar dezelfde
 * detailpagina.
 *
 * **Op een telefoon blijven alleen het beeld en de titel over**
 * (11 september 2026). De samenvatting en de metaregel vallen daar weg: op
 * een smal scherm duwen ze de lijst met posts onder de vouw, en de
 * samenvatting staat toch al op de postpagina zelf.
 */
import type { Post } from '../lib/posts';
import type { Locale } from '../i18n/ui';
import { shortDate, isoDate } from '../lib/date';
import CategoryBadge from './CategoryBadge.astro';
import PostImage from './PostImage.astro';
import LikeButton from './LikeButton.astro';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
/*
 * De sleutel waaronder de likes van deze post in de database staan. Bewust
 * de collectie en niet de categorie: een categorie kan veranderen (een post
 * verhuist van Classic naar Forever) en dan zouden de likes eraan
 * verdwijnen. De collectie ligt vast zolang de post bestaat.
 */
const postId = `${post.collection}/${post.slug}`;
---

<article class="wf-featured">
  <a class="wf-featured__shot" href={post.href} tabindex="-1" aria-hidden="true">
    <!-- Het grootste element boven de vouw: meteen en met voorrang laden (§17). -->
    <PostImage image={post.image} alt={post.imageAlt ?? ''} variant="featured" eager>
      <CategoryBadge category={post.category} locale={locale} overlay />
    </PostImage>
  </a>

  <h3 class="wf-featured__title">
    <a href={post.href}>{post.title}</a>
  </h3>

  <p class="wf-featured__summary">{post.description}</p>

  <div class="wf-featured__meta">
    <time datetime={isoDate(post.date)}>{shortDate(post.date, locale)}</time>
    <LikeButton postId={postId} locale={locale} />
  </div>
</article>

<style>
  .wf-featured {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .wf-featured__shot { display: block; }

  .wf-featured__title {
    font-size: 40px;
    line-height: 1.04;
  }

  .wf-featured__summary {
    font-size: 16px;
    line-height: 1.65;
    max-width: 48ch;
    color: var(--wf-muted);
  }

  .wf-featured__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 13.5px;
    color: var(--wf-muted);
  }

  @media (max-width: 899px) {
    .wf-featured { gap: 10px; }
    .wf-featured__title { font-size: 24px; line-height: 1.12; }

    /* Alleen beeld en titel; zie de uitleg bovenaan. */
    .wf-featured__summary,
    .wf-featured__meta { display: none; }
  }
</style>
