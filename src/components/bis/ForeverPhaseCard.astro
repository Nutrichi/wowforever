---
/*
 * Eén fase van WoW Forever: het venster, de raids, de dungeons en wat
 * Blizzard er wel en niet over gezegd heeft.
 *
 * Staat drie keer naast elkaar op /bis/ (ForeverPhases.astro) en alleen op
 * de eigen pagina van die fase (/bis/forever/p1/, BisPhasePage.astro).
 *
 * Alle namen en datums komen uit config/bis.ts (foreverPhases). Kondigt
 * Blizzard een fase aan, dan gaat dat bestand mee, samen met /forever/ en de
 * nieuwspost (PROJECT_SPEC.md §2.10).
 */
import type { ForeverPhase } from '../../config/bis';
import { bisT, phaseLabel } from '../../i18n/bis';
import { longDate } from '../../lib/date';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  phase: ForeverPhase;
  /** Op de eigen pagina van een fase staat de fasenaam al in de h1. */
  showTitle?: boolean;
}

const { locale, phase, showTitle = true } = Astro.props;
const t = bisT(locale);

const windowLabel: Record<string, string> = {
  launch: t('windowLaunch'),
  spring27: t('windowSpring27'),
  summer27: t('windowSummer27'),
};

const noteLabel: Record<string, string> = {
  p1: t('foreverNoteP1'),
  p2: t('foreverNoteP2'),
  p3: t('foreverNoteP3'),
};

/* Een raid zonder naam staat er als wat Blizzard er wel over gezegd heeft. */
function raidText(raid: { name: string; players: number; kind?: 'new' | 'revamp' }): string {
  if (raid.name) return raid.players ? `${raid.name} (${t('playersN', { n: raid.players })})` : raid.name;
  if (raid.kind === 'revamp') return t('raidTbaRevamp');
  return raid.players ? t('raidTbaSized', { n: raid.players }) : t('raidTba');
}
---

<div class="wf-fphase">
  <div class="wf-fphase__head">
    {showTitle && <span class="wf-fphase__n">{phaseLabel(phase.id, locale)}</span>}
    <span class="wf-fphase__window">{windowLabel[phase.window] ?? phase.window}</span>
  </div>

  <dl class="wf-fphase__rows">
    <div class="wf-fphase__row">
      <dt>{t('raidsLabel')}</dt>
      <dd>
        <ul>
          {phase.raids.map((raid) => <li>{raidText(raid)}</li>)}
        </ul>
        {phase.raidsOpen && (
          <p class="wf-fphase__when">{t('raidsOpenOn', { date: longDate(new Date(phase.raidsOpen), locale) })}</p>
        )}
      </dd>
    </div>

    <div class="wf-fphase__row">
      <dt>{t('dungeonsLabel')}</dt>
      <dd>
        {phase.dungeons.length > 0 ? (
          <ul>
            {phase.dungeons.map((dungeon) => (
              <li>
                {dungeon.name}
                <span class="wf-fphase__levels">{t('dungeonLevels', { levels: dungeon.levels })}</span>
              </li>
            ))}
          </ul>
        ) : (
          <ul><li>{t('dungeonsTba', { n: phase.dungeonsUnnamed ?? 0 })}</li></ul>
        )}
      </dd>
    </div>
  </dl>

  {phase.note && noteLabel[phase.note] && (
    <p class="wf-fphase__note">{noteLabel[phase.note]}</p>
  )}
</div>

<style>
  .wf-fphase {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 15px 16px;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-card-sm);
    background: var(--wf-raised-soft);
  }

  .wf-fphase__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .wf-fphase__n {
    font-family: var(--wf-serif);
    font-weight: 700;
    font-size: 16px;
    color: var(--wf-ink);
  }

  .wf-fphase__window {
    font-family: var(--wf-display);
    font-weight: 600;
    font-size: 11.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--wf-accent);
  }

  .wf-fphase__rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }

  .wf-fphase__row dt {
    font-family: var(--wf-display);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--wf-label);
    margin-bottom: 4px;
  }

  .wf-fphase__row dd { margin: 0; }

  .wf-fphase__row ul {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.45;
    color: var(--wf-ink);
  }

  .wf-fphase__levels {
    margin-left: 7px;
    font-size: 12.5px;
    color: var(--wf-label);
    font-variant-numeric: tabular-nums;
  }

  .wf-fphase__when {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--wf-muted);
  }

  .wf-fphase__note {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--wf-border);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--wf-muted);
  }

  @media (max-width: 899px) {
    .wf-fphase__note { margin-top: 0; }
  }
</style>
