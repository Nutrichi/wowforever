---
/*
 * Het inschrijfveld voor de nieuwsbrief, onder de feed op de homepage
 * (PROJECT_SPEC.md §6.3, handoff §7.1: SUBSCRIBE TO THE NEWSLETTER).
 *
 * Het adres gaat naar de tabel `newsletter` via de functie
 * `subscribe_newsletter` uit `supabase/schema.sql`. Versturen gebeurt buiten de
 * site: Nutri exporteert de lijst als CSV. Geen privacypagina en geen
 * uitlegregel onder het veld (Nutri, 14 september 2026).
 *
 * Gebouwd voor het Supabase-project bestaat (Nutri, 15 september 2026). Tot
 * dan faalt het zacht en zegt het eerlijk dat inschrijven niet lukt.
 *
 * Dezelfde drempels tegen bots als bij `/submit/`: een honeypot, een minimale
 * tijd, en hoogstens drie inschrijvingen per uur per browser in de database.
 */
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Hoeveel seconden er minstens tussen laden en inschrijven zitten. */
const minSeconds = 3;
---

<form class="wf-news" data-wf-newsletter data-min-seconds={minSeconds} data-lang={locale} novalidate>
  <label class="wf-news__field">
    <span class="wf-sr">{t('newsletter.label')}</span>
    <input type="email" name="email" maxlength="254" inputmode="email" autocomplete="email" placeholder={t('newsletter.placeholder')} required />
  </label>

  <div class="wf-news__pot" aria-hidden="true">
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <button type="submit" class="wf-news__button" data-wf-newsletter-button>{t('newsletter.button')}</button>
  <p class="wf-news__message" data-wf-newsletter-message role="status" hidden></p>

  <template
    data-wf-newsletter-text
    data-send={t('newsletter.button')}
    data-sending={t('newsletter.sending')}
    data-thanks={t('newsletter.thanks')}
    data-email={t('newsletter.errorEmail')}
    data-network={t('newsletter.errorNetwork')}
    data-storage={t('newsletter.errorStorage')}
    data-fast={t('newsletter.errorTooFast')}
  ></template>
</form>

<style>
  .wf-news {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .wf-news__field input {
    width: 100%;
    padding: 9px 16px;
    background: var(--wf-raised);
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-pill);
    font: inherit;
    font-size: 15px;
    color: var(--wf-ink);
    text-align: center;
    transition: var(--wf-transition);
  }

  .wf-news__field input:focus {
    outline: none;
    border-color: var(--wf-arcane);
  }

  /* Niet display:none: sommige bots slaan verborgen velden over. */
  .wf-news__pot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .wf-news__button {
    padding: 9px 0;
    border: 1px solid var(--wf-accent);
    border-radius: var(--wf-r-pill);
    background: linear-gradient(180deg, #e0b77a, #c39449);
    box-shadow: var(--wf-glow-primary);
    font-family: var(--wf-display);
    font-size: 16px;
    letter-spacing: .12em;
    color: #1a1408;
    transition: var(--wf-transition);
  }

  .wf-news__button[disabled] { opacity: .6; cursor: default; }

  .wf-news__message {
    font-size: 13.5px;
    text-align: center;
    color: var(--wf-muted);
  }

  .wf-news__message.is-error { color: var(--wf-accent); }

  @media (max-width: 899px) {
    .wf-news__button,
    .wf-news__field input { padding-block: 11px; }
  }
</style>

<script>
  import { subscribeNewsletter } from '../lib/supabase';

  document.querySelectorAll<HTMLFormElement>('[data-wf-newsletter]').forEach((form) => {
    const text = form.querySelector<HTMLElement>('[data-wf-newsletter-text]')!.dataset;
    const button = form.querySelector<HTMLButtonElement>('[data-wf-newsletter-button]')!;
    const message = form.querySelector<HTMLElement>('[data-wf-newsletter-message]')!;
    const minSeconds = Number(form.dataset.minSeconds ?? '3');
    const loadedAt = Date.now();

    const show = (content: string, isError: boolean) => {
      message.textContent = content;
      message.classList.toggle('is-error', isError);
      message.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.hidden = true;

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();

      // De honeypot: een bot krijgt een geslaagde inschrijving te zien.
      if (String(data.get('website') ?? '').trim()) {
        form.reset();
        show(text.thanks ?? '', false);
        return;
      }

      if (Date.now() - loadedAt < minSeconds * 1000) {
        show(text.fast ?? '', true);
        return;
      }

      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        show(text.email ?? '', true);
        return;
      }

      button.disabled = true;
      button.textContent = text.sending ?? '';
      const result = await subscribeNewsletter(email, form.dataset.lang ?? 'en');
      button.disabled = false;
      button.textContent = text.send ?? '';

      if (result.ok) {
        form.reset();
        show(text.thanks ?? '', false);
        return;
      }

      show(result.reason === 'storage' ? (text.storage ?? '') : (text.network ?? ''), true);
    });
  });
</script>
