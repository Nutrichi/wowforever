---
/*
 * De voettekst (PROJECT_SPEC.md §10): copyright, de verplichte disclaimer en
 * de links naar Ko-fi (fooi), YouTube, Twitch, Discord, RestedXP en de iOS-app.
 *
 * Ko-fi staat vooraan met een eigen icoon: een kopje met een hartje, getekend
 * in de kleuren van de huisstijl in plaats van het logo van Ko-fi.
 *
 * Klein gehouden en nergens vastgeplakt. De disclaimer past op één regel (Nutri,
 * 14 september 2026): geen band met Blizzard en niet door Blizzard goedgekeurd.
 *
 * Een sociale link verschijnt alleen als zijn URL in config/site.ts staat.
 */
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { appStoreUrl, kofiUrl, restedxpUrl, social } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* Het jaartal van de build; elke push bouwt opnieuw. */
const year = new Date().getFullYear();

const links = [
  { label: t('footer.tip'), href: kofiUrl, rel: 'noopener', kofi: true },
  { label: t('footer.youtube'), href: social.youtube, rel: 'noopener' },
  { label: t('footer.twitch'), href: social.twitch, rel: 'noopener' },
  { label: t('footer.discord'), href: social.discord, rel: 'noopener' },
  { label: t('footer.restedxp'), href: restedxpUrl, rel: 'noopener sponsored' },
  /* Staat er pas zodra de app in de App Store is; leeg betekent weg (config/site.ts). */
  { label: t('footer.app'), href: appStoreUrl, rel: 'noopener' },
].filter((link) => link.href !== '');
---

<footer class="wf-footer" aria-label={t('footer.label')}>
  <div class="wf-footer__inner">
    <p class="wf-footer__text">
      <span class="wf-footer__copy">{t('footer.copyright').replace('{y}', String(year))}</span>
      <span class="wf-footer__sep" aria-hidden="true"> · </span>
      <span>{t('site.disclaimer')}</span>
    </p>

    {links.length > 0 && (
      <ul class="wf-footer__links">
        {links.map((link) => (
          <li>
            <a href={link.href} rel={link.rel} class="wf-footer__link" title={link.kofi ? 'Ko-fi' : undefined}>
              {link.kofi && (
                <svg class="wf-footer__kofi" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path d="M3.5 6.5h13v7.5a4.5 4.5 0 0 1-4.5 4.5H8a4.5 4.5 0 0 1-4.5-4.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                  <path d="M16.5 8.5h1.5a2.75 2.75 0 0 1 0 5.5h-1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                  <path class="wf-footer__kofiheart" d="M10 15.2l-2.6-2.5a1.55 1.55 0 0 1 2.6-1.7 1.55 1.55 0 0 1 2.6 1.7z" />
                </svg>
              )}
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</footer>

<style>
  .wf-footer {
    border-top: 1px solid var(--wf-border);
    background: var(--wf-header);
  }

  .wf-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 28px;
    width: 100%;
    max-width: var(--wf-max);
    margin: 0 auto;
    padding: 14px 26px 16px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--wf-label);
  }

  .wf-footer__text {
    flex: 1 1 340px;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wf-footer__copy { white-space: nowrap; }

  .wf-footer__links {
    margin: 0;
    margin-left: auto;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .wf-footer__link {
    font-family: var(--wf-display);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--wf-muted);
    transition: color .16s ease;
  }

  .wf-footer__link:hover { color: var(--wf-ink); }

  /* Ko-fi: het kopje in de linkkleur, het hartje in het accent. */
  .wf-footer__link:has(.wf-footer__kofi) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .wf-footer__kofi { flex: none; }
  .wf-footer__kofiheart { fill: var(--wf-accent); }

  @media (max-width: 899px) {
    .wf-footer__inner {
      gap: 8px 14px;
      padding: 12px 16px 14px;
      font-size: 11px;
    }

    .wf-footer__text { flex: 1 1 100%; white-space: normal; }

    .wf-footer__links {
      margin-left: 0;
      gap: 8px 16px;
    }

    .wf-footer__link { font-size: 12px; }
  }
</style>
