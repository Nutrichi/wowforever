---
/*
 * Taalkiezer, zes talen (PROJECT_SPEC.md §11).
 *
 * Het ontwerp tekende vier vakken omdat er vier in de rij pasten; er zijn
 * er zes, dus op mobiel twee rijen van drie.
 *
 * Gebouwd met <details> en echte links: werkt zonder JavaScript, en een
 * crawler ziet de zes URL's staan. De browsertaal kiest alleen bij het
 * allereerste bezoek (BaseLayout, §11); daarna kiest de bezoeker hier zelf.
 */
import { locales, localeNames, localeShort, type Locale } from '../i18n/ui';
import { localizePath, stripLocale, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Het taalloze pad van de huidige pagina, zodat we erop blijven staan. */
  pathname: string;
  variant?: 'bar' | 'grid';
}

const { locale, pathname, variant = 'bar' } = Astro.props;
const t = useTranslations(locale);
const bare = stripLocale(pathname);
/* Met slash op het einde, zoals elke interne link: zo stuurt GitHub Pages niet eerst door. */
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);

const options = locales.map((code) => ({
  code,
  name: localeNames[code],
  short: localeShort[code],
  href: withSlash(localizePath(bare, code)),
  current: code === locale,
}));
---

{variant === 'bar' ? (
  <details class="wf-lang" data-wf-lang>
    <summary class="wf-lang__summary" aria-label={t('lang.label')}>
      <span>{localeShort[locale]}</span>
    </summary>
    <ul class="wf-lang__list">
      {options.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.code}
            lang={option.code}
            aria-current={option.current ? 'true' : undefined}
            class:list={['wf-lang__link', { 'is-current': option.current }]}
            data-wf-lang-pick={option.code}
          >
            <span class="wf-lang__short">{option.short}</span>
            <span class="wf-lang__name">{option.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </details>
) : (
  <div class="wf-langgrid">
    <p class="wf-langgrid__label">{t('lang.label')}</p>
    <ul class="wf-langgrid__list">
      {options.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.code}
            lang={option.code}
            aria-current={option.current ? 'true' : undefined}
            class:list={['wf-langgrid__box', { 'is-current': option.current }]}
            data-wf-lang-pick={option.code}
          >
            {option.short}
            <span class="wf-sr"> {option.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  /* --- Het vakje in de header --- */
  .wf-lang {
    position: relative;
    flex: none;
  }

  .wf-lang__summary {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-field);
    padding: 7px 11px;
    font-size: 12.5px;
    letter-spacing: .08em;
    color: var(--wf-muted);
    cursor: pointer;
    list-style: none;
    transition: var(--wf-transition);
  }

  /* Weg met het standaard driehoekje. */
  .wf-lang__summary::-webkit-details-marker { display: none; }
  .wf-lang__summary::marker { content: ''; }

  .wf-lang__summary:hover {
    border-color: var(--wf-arcane);
    color: var(--wf-ink);
  }

  .wf-lang__list {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 40;
    margin: 0;
    padding: 5px;
    list-style: none;
    min-width: 168px;
    background: var(--wf-raised);
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-field-lg);
    /* Zonder dit valt de lijst weg tegen de pagina op nacht. */
    box-shadow: 0 12px 32px rgba(7, 6, 15, .55);
  }

  .wf-lang__link {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 7px 9px;
    border-radius: var(--wf-r-field);
    font-size: 13.5px;
    color: var(--wf-muted);
    transition: var(--wf-transition), color .16s ease, background-color .16s ease;
  }

  .wf-lang__link:hover {
    background: var(--wf-accent-soft);
    color: var(--wf-ink);
  }

  .wf-lang__link.is-current {
    color: var(--wf-ink);
    background: var(--wf-accent-soft);
  }

  .wf-lang__short {
    flex: none;
    width: 2.1em;
    font-size: 12px;
    letter-spacing: .08em;
    color: var(--wf-arcane);
  }

  /* --- Het raster in het mobiele menu: twee rijen van drie --- */
  .wf-langgrid__label {
    font-size: 14px;
    color: var(--wf-muted);
    margin-bottom: 8px;
  }

  .wf-langgrid__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wf-langgrid__box {
    display: block;
    text-align: center;
    padding: 10px 0;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-field-lg);
    font-size: 13px;
    letter-spacing: .06em;
    color: var(--wf-muted);
    transition: var(--wf-transition), color .16s ease, background-color .16s ease;
  }

  .wf-langgrid__box:hover { border-color: var(--wf-arcane); }

  .wf-langgrid__box.is-current {
    border-color: var(--wf-accent);
    background: var(--wf-accent-soft);
    color: var(--wf-ink);
  }
</style>

<script>
  /*
   * Een zelf gekozen taal ligt vast voor deze browser (Nutri, 13 september
   * 2026, §11). Bij een klik op een taal, in de koptekst of in het mobiele
   * menu, wordt die weggeschreven voor de link zijn werk doet. Het script in
   * de head van BaseLayout leest hem op elke volgende pagina en stuurt een
   * pagina in een andere taal naar de gekozen taal.
   *
   * Eén luisteraar op het document, zodat beide taalkiezers meedoen. Zonder
   * localStorage blijft de link gewoon een link.
   */
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const code = event.target.closest<HTMLAnchorElement>('[data-wf-lang-pick]')?.dataset.wfLangPick;
    if (!code) return;
    try {
      localStorage.setItem('wf-lang', code);
      localStorage.setItem('wf-lang-auto', '1');
    } catch {
      // Privémodus: de keuze geldt dan alleen voor deze klik.
    }
  });
</script>
