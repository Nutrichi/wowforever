---
/*
 * De pil voor Daily Clips en Streams (handoff, scherm 6). Hetzelfde skelet als
 * Pill.astro (§5.1): een kolom van vaste breedte links, een lijn, de titel,
 * dezelfde lijn nog eens, en een kolom van vaste breedte rechts. De stijl
 * staat hier apart omdat Astro stijlen per component afschermt.
 *
 * De verschillen met de pil van de homepage, allemaal uit de handoff:
 * - links een play-driehoek (clip) of een statusbolletje (stream) in plaats
 *   van een ruitje;
 * - de titel is tweeregelig, met eronder kanaal, weergaven en ouderdom, of
 *   het kanaal, de starttijd en de taal;
 * - rechts geen hartje maar de duur of het aantal kijkers.
 *
 * Een uitgelicht item in de lijst krijgt de gele rand (§10.4).
 */
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { Clip, Stream } from '../lib/feeds';
import { clipDuration, clockTime, compactNumber, languageName, timeAgo } from '../lib/feed-format';

interface Props {
  clip?: Clip;
  stream?: Stream;
  picked?: boolean;
  sponsored?: boolean;
  now: Date;
  locale: Locale;
}

const { clip, stream, picked = false, sponsored = false, now, locale } = Astro.props;
const t = useTranslations(locale);

const title = clip?.title || stream?.title || stream?.name || '';
const href = clip?.url ?? stream?.url ?? '';
const channel = clip?.channel ?? stream?.name ?? '';

const sub = clip
  ? [
      clip.channel,
      t('clips.views').replace('{n}', compactNumber(clip.views, locale)),
      timeAgo(new Date(clip.publishedAt), now, locale),
    ]
  : stream?.live && stream.startedAt
    ? [
        stream.name,
        t('streams.started').replace('{time}', clockTime(new Date(stream.startedAt), locale)),
        languageName(stream.language, locale),
      ]
    : [stream?.name, t('streams.offline')];

const value = clip
  ? clipDuration(clip.duration)
  : stream?.live ? compactNumber(stream.viewers, locale) : '–';

/*
 * Voor het afspeelscript (src/scripts/feed-stage.ts): een klik speelt dit
 * item in het grote blok. Het krijgt de metaregel mee zoals dat blok hem
 * toont, bij een live stream met het spel erbij. Een stream houdt zijn link
 * naar Twitch voor schermen die te smal zijn voor de Twitch-speler.
 */
const linkAttrs = {
  'data-wf-play': clip ? 'clip' : 'stream',
  'data-id': clip?.id ?? stream?.channel ?? '',
  'data-title': title,
  'data-meta': [...sub, ...(stream?.live ? [stream.game] : [])].filter(Boolean).join(' · '),
  ...(stream ? { target: '_blank', rel: 'noopener' } : {}),
};

/* Het gele randje is kleur; een schermlezer hoort het als woord. */
const pickLabel = picked ? `${sponsored ? t('feed.sponsored') : t('feed.featured')}, ` : '';
---

<li
  class:list={['wf-feedpill', clip ? 'is-clip' : 'is-stream', { 'is-picked': picked }]}
  data-wf-post
  data-wf-clip-id={clip?.id}
  data-id={stream?.channel.toLowerCase()}
  data-language={stream?.language || undefined}
  data-title={`${title} ${channel}`.toLowerCase()}
>
  <span class="wf-feedpill__icon" aria-hidden="true">
    {clip
      ? <><span class="wf-feedpill__play"></span><span class="wf-feedpill__check"></span></>
      : <span class:list={['wf-feedpill__dot', { 'is-live': stream?.live }]}></span>}
  </span>

  <span class="wf-feedpill__rule" aria-hidden="true"></span>

  <a class="wf-feedpill__link" href={href} {...linkAttrs}>
    {pickLabel && <span class="wf-sr">{pickLabel}</span>}
    {clip && <span class="wf-sr wf-feedpill__watched">{t('clips.watched')}, </span>}
    <span class="wf-feedpill__title">{title}</span>
    <span class="wf-feedpill__sub">{sub.filter(Boolean).join(' · ')}</span>
  </a>

  <span class="wf-feedpill__rule" aria-hidden="true"></span>

  <span class="wf-feedpill__value">{value}</span>
</li>

<style>
  .wf-feedpill {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 44px;
    background: var(--wf-raised);
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-pill);
    overflow: hidden;
    /* Alleen de rand animeert, net als in Pill.astro; zie de uitleg daar. */
    transition: border-color .16s ease;
  }

  .wf-feedpill:hover,
  .wf-feedpill:focus-within {
    border-color: var(--wf-arcane);
    box-shadow: var(--wf-glow-pill);
  }

  .wf-feedpill.is-picked {
    border-color: var(--wf-yellow);
    box-shadow: var(--wf-glow-featured);
  }

  /*
   * Al bekeken (Nutri, 11 september 2026): een vinkje in plaats van het
   * driehoekje, en een gedempte titel. src/scripts/feed-stage.ts zet de
   * klasse; een schermlezer hoort "Watched" voor de titel.
   */
  .wf-feedpill__check,
  .wf-feedpill__watched { display: none; }

  .wf-feedpill.is-watched .wf-feedpill__play { display: none; }

  .wf-feedpill.is-watched .wf-feedpill__check {
    display: block;
    width: 6px;
    height: 11px;
    margin-top: -3px;
    border-right: 2px solid var(--wf-muted);
    border-bottom: 2px solid var(--wf-muted);
    transform: rotate(45deg);
  }

  .wf-feedpill.is-watched .wf-feedpill__watched { display: block; }
  .wf-feedpill.is-watched .wf-feedpill__title { color: var(--wf-muted); }

  /* Wat nu in het grote blok speelt. */
  .wf-feedpill.is-playing {
    border-color: var(--wf-arcane);
    box-shadow: var(--wf-glow-pill);
  }

  .wf-feedpill__icon {
    flex: none;
    width: 40px;
    align-self: stretch;
    display: grid;
    place-items: center;
  }

  .wf-feedpill__play {
    display: block;
    width: 0;
    height: 0;
    margin-left: 3px;
    border-left: 10px solid var(--wf-accent);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    filter: drop-shadow(0 0 7px rgba(242, 94, 61, .8));
  }

  /* Grijs is offline bij de laatste ophaling; groen is live. */
  .wf-feedpill__dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--wf-muted-dim);
  }

  .wf-feedpill__dot.is-live {
    background: var(--wf-green);
    box-shadow: 0 0 9px var(--wf-green);
  }

  .wf-feedpill__rule {
    flex: none;
    width: 1px;
    align-self: stretch;
    background: var(--wf-border);
  }

  .wf-feedpill__link {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 5px 14px;
  }

  /* De hele pil is klikbaar: de link legt een onzichtbaar vlak eroverheen. */
  .wf-feedpill__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .wf-feedpill__title,
  .wf-feedpill__sub {
    display: block;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wf-feedpill__title {
    font-size: 14px;
    line-height: 1.4;
    color: var(--wf-ink-soft);
  }

  .wf-feedpill__sub {
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--wf-muted);
  }

  .wf-feedpill__value {
    flex: none;
    align-self: stretch;
    display: grid;
    place-items: center;
    font-size: 12.5px;
    color: var(--wf-muted);
    font-variant-numeric: tabular-nums;
  }

  .is-clip .wf-feedpill__value { width: 64px; }
  .is-stream .wf-feedpill__value { width: 66px; }

  /* De focusring hoort om de pil, niet om het onzichtbare vlak. */
  .wf-feedpill__link:focus-visible { outline: none; }

  .wf-feedpill:has(.wf-feedpill__link:focus-visible) {
    outline: 2px solid var(--wf-arcane);
    outline-offset: 2px;
  }

  .wf-feedpill.is-new { animation: wfRise .4s ease both; }

  @media (max-width: 899px) {
    .wf-feedpill__icon { width: 34px; }
    .wf-feedpill__link { padding: 5px 12px; }
    .wf-feedpill__title { font-size: 13.5px; }
    .is-clip .wf-feedpill__value,
    .is-stream .wf-feedpill__value { width: 56px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-feedpill.is-new { animation: none; }
  }
</style>
