---
/*
 * Bovenaan elke pagina van een Forever-tradeskill (19 oktober 2026): de twaalf
 * tradeskills als kleine chips, en daaronder de tabs van deze tradeskill (Overzicht,
 * Recepten, Levelen 1-300), elk een eigen adres (Nutri koos aparte subpagina's).
 */
import type { Locale } from '../../i18n/ui';
import { tradeskills } from '../../config/guides';
import { hasRecipes, hasRoute, tsData, tsPath } from '../../lib/tradeskills-forever';
import { tsT } from '../../i18n/tradeskill-pages';

interface Props {
  locale: Locale;
  skill: string;
  current: 'overview' | 'recipes' | 'leveling';
}

const { locale, skill, current } = Astro.props;
const t = tsT(locale);
const skills = tradeskills.filter((s) => s.eras.includes('forever') && tsData(s.key));
const data = tsData(skill);
const tabs = [
  { key: 'overview', label: t('tabOverview'), href: tsPath(locale, skill) },
  ...(hasRecipes(skill) ? [{ key: 'recipes', label: `${t('tabRecipes')} ${data?.recipes.length ?? ''}`, href: tsPath(locale, skill, 'recipes') }] : []),
  ...(hasRoute(skill) ? [{ key: 'leveling', label: t('tabLeveling'), href: tsPath(locale, skill, 'leveling') }] : []),
];
---

<nav class="wf-tsnav" data-pagefind-ignore>
  <div class="wf-tsnav__skills">
    {skills.map((s) => (
      <a class="wf-tsnav__skill" href={tsPath(locale, s.key)} aria-current={s.key === skill ? 'true' : undefined}>{s.name}</a>
    ))}
  </div>
  {tabs.length > 1 && (
    <div class="wf-tsnav__tabs">
      {tabs.map((tab) => (
        <a class="wf-tsnav__tab" href={tab.href} aria-current={tab.key === current ? 'page' : undefined}>{tab.label}</a>
      ))}
    </div>
  )}
</nav>

<style>
  .wf-tsnav { display: flex; flex-direction: column; gap: 12px; margin: 16px 0 20px; }
  .wf-tsnav__skills { display: flex; flex-wrap: wrap; gap: 6px; }
  .wf-tsnav__skill {
    padding: 2px 10px;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-pill);
    font-size: 12.5px;
    color: var(--wf-muted);
    text-decoration: none;
  }
  .wf-tsnav__skill:hover { border-color: var(--wf-accent-deep); color: var(--wf-ink); }
  .wf-tsnav__skill[aria-current='true'] { border-color: var(--wf-accent-deep); color: var(--wf-accent-bright); background: var(--wf-accent-wash); }

  .wf-tsnav__tabs { display: flex; gap: 0; border-bottom: 1px solid var(--wf-border); }
  .wf-tsnav__tab {
    padding: 9px 16px;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    font-family: var(--wf-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--wf-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .wf-tsnav__tab:hover { color: var(--wf-ink); }
  .wf-tsnav__tab[aria-current='page'] { color: var(--wf-accent-bright); border-bottom-color: var(--wf-accent); }

  @media (max-width: 599px) {
    .wf-tsnav__skills { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -16px; padding-inline: 16px; }
    .wf-tsnav__skills::-webkit-scrollbar { display: none; }
    .wf-tsnav__skill { flex: none; }
    .wf-tsnav__tab { padding: 8px 11px; font-size: 14px; }
  }
</style>
