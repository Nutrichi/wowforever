---
/*
 * Het logo. Dezelfde meetkunde als assets/favicon.svg: niet opnieuw bedacht,
 * want de meetkunde hoort alleen in tools/mkicon.py te wijzigen
 * (PROJECT_SPEC.md §9). Voorstel A, "Arcane gem", gekozen door Nutri op
 * 14 september 2026: een gouden ruitvormige rand,
 * een arcaanblauwe ruit erin en een lichte gouden kern.
 *
 * De kleuren staan als letterlijke hex in de SVG: een CSS-variabele werkt niet
 * in een fill-attribuut.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={['wf-logo', className]}
  viewBox="0 0 200 200"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path fill="#e0b77a" fill-rule="evenodd" d="M100 4L196 100L100 196L4 100Z M100 24L176 100L100 176L24 100Z" />
  <path fill="#4f7fd9" d="M100 42L158 100L100 158L42 100Z" />
  <path fill="#f0cd97" d="M100 78L122 100L100 122L78 100Z" />
</svg>

<style>
  .wf-logo {
    flex: none;
    filter: var(--wf-glow-logo);
  }
</style>
