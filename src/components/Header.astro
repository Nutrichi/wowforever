---
/*
 * De header (handoff §5). Links logo en woordmerk, daarnaast de
 * hoofdnavigatie, rechts taal en thema. Onder 900 px blijft alleen logo plus
 * hamburger over en verhuist de rest naar het mobiele menu.
 *
 * **Zoeken staat hier niet meer**, maar in de balk eronder naast de
 * RestedXP-pil (Nutri, 18 september 2026). De navigatie had de breedte nodig:
 * met acht tabs, een zoekveld, de taalkiezer en de themaknop stond alles op
 * elkaar gedrukt zodra er een tab bij kwam.
 *
 * Welke tabs erin staan, is al beslist door getNav() op basis van de inhoud
 * (PROJECT_SPEC.md §4.2).
 */
import type { Locale } from '../i18n/ui';
import type { NavItem } from '../config/nav';
import { isCurrent } from '../config/nav';
import { localizePath, useTranslations } from '../i18n/utils';
import Logo from './Logo.astro';
import LangPicker from './LangPicker.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  nav: NavItem[];
  pathname: string;
}

const { locale, nav, pathname } = Astro.props;
const t = useTranslations(locale);
const home = localizePath('', locale);
---

<div class="wf-header">
  <div class="wf-header__inner">
    <a class="wf-brand" href={home}>
      <Logo size={28} class="wf-brand__logo" />
      <span class="wf-brand__word">{t('site.title')}</span>
    </a>

    <nav class="wf-nav" aria-label={t('nav.label')}>
      <ul class="wf-nav__list">
        {nav.map((item) => (
          <li>
            <a
              href={item.path}
              data-wf-era-links={item.eraLinks}
              class:list={['wf-nav__item', { 'is-current': isCurrent(item.path, pathname) }]}
              aria-current={isCurrent(item.path, pathname) ? 'page' : undefined}
            >
              {t(item.labelKey)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="wf-header__tools">
      <LangPicker locale={locale} pathname={pathname} variant="bar" />
      <ThemeToggle locale={locale} variant="bar" />
    </div>

    <button
      type="button"
      class="wf-burger"
      data-wf-menu-open
      aria-label={t('nav.open')}
      aria-expanded="false"
      aria-controls="wf-mobile-menu"
    >
      <span class="wf-burger__bars">
        <span class="wf-burger__bar is-1"></span>
        <span class="wf-burger__bar is-2"></span>
        <span class="wf-burger__bar is-3"></span>
      </span>
    </button>
  </div>
</div>

<style>
  /* Vastgepind wordt in de omhulling `.wf-top` in BaseLayout, samen met de tweede balk. */
  .wf-header { background: var(--wf-header); }

  .wf-header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: var(--wf-max);
    margin: 0 auto;
    padding: 14px 26px;
  }

  .wf-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .wf-brand__word {
    font-family: var(--wf-serif);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: .04em;
    line-height: 1;
    white-space: nowrap;
    color: var(--wf-ink);
    text-shadow: var(--wf-glow-wordmark);
  }

  .wf-nav__list {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Elk item heeft zijn eigen 1px rand, ook het actieve. Zo zijn ze allemaal
   * exact even hoog (handoff §5).
   */
  .wf-nav__item {
    display: block;
    font-family: var(--wf-display);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: .11em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 8px 13px;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-field);
    color: var(--wf-muted);
    transition: var(--wf-transition), color .16s ease;
  }

  .wf-nav__item:hover {
    border-color: var(--wf-arcane);
    color: var(--wf-ink);
  }

  .wf-nav__item.is-current {
    border-color: var(--wf-accent-deep);
    background: var(--wf-accent-soft);
    color: var(--wf-accent-bright);
  }

  .wf-header__tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  /* --- De hamburger: alleen onder 900 px --- */
  .wf-burger {
    display: none;
    margin-left: auto;
    /* Een raakvlak van 44 px: 24 px inhoud plus 10 px rondom. */
    padding: 10px;
  }

  .wf-burger__bars {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    width: 20px;
  }

  .wf-burger__bar {
    height: 2px;
    border-radius: 2px;
  }

  .wf-burger__bar.is-1 { width: 20px; background: var(--wf-ink); }
  .wf-burger__bar.is-2 { width: 20px; background: var(--wf-arcane); }
  .wf-burger__bar.is-3 { width: 14px; background: var(--wf-accent); }

  /* Tussen 900 en 1180 px wordt de ruimte krap: iets dichter op elkaar. */
  @media (max-width: 1179px) {
    .wf-header__inner { gap: 16px; }
    .wf-nav__item { padding: 8px 10px; letter-spacing: .08em; }
  }

  @media (max-width: 899px) {
    .wf-header__inner {
      gap: 12px;
      padding: 14px 16px;
    }

    .wf-brand__word { font-size: 19px; }
    /* `:global`, want de svg komt uit Logo.astro en draagt het scope-attribuut van dit bestand niet. */
    .wf-brand :global(.wf-brand__logo) { width: 24px; height: 24px; }
    .wf-nav,
    .wf-header__tools { display: none; }
    .wf-burger { display: block; }
  }
</style>
