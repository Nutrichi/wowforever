---
/*
 * REPUTATIONS op /reputations/ (PROJECT_SPEC.md §5, handoff §7.5).
 *
 * Alleen voor WoW Forever (Nutri, 15 september 2026), dus zonder era-rij. In
 * groepen: eerst de facties voor iedereen, dan Alliance, dan Horde. Sinds
 * 19 oktober 2026 (Nutri: "too big, it need to be more reputations on 1 page")
 * een raster van compacte kaarten: naam, standing van tot, zone en twee regels
 * beloningen. Hoe je farmt staat op de pagina van de factie; de inleiding is weg.
 *
 * De balk met een "community average" en het snelheidslabel uit de handoff
 * staan er bewust niet: daar bestaan geen cijfers voor (SCHRIJFSTIJL.md).
 */
import type { Locale } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { standingNames } from '../../config/reputations';
import { getReputations, reputationPath, reputationsUpdated } from '../../lib/reputations';
import { repT } from '../../i18n/reputations';
import { longDate } from '../../lib/date';
import { breadcrumbJsonLd } from '../../lib/structured-data';
import '../../styles/guides.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = repT(locale);
const ui = useTranslations(locale);
const factions = await getReputations(locale);
const updated = await reputationsUpdated();
const side = { alliance: t('sideAlliance'), horde: t('sideHorde'), both: t('sideBoth') };
const groupTitle = { both: t('groupBoth'), alliance: t('groupAlliance'), horde: t('groupHorde') };
const groups = (['both', 'alliance', 'horde'] as const)
  .map((key) => ({ key, items: factions.filter((faction) => faction.data.side === key) }))
  .filter((group) => group.items.length > 0);

const title = t('title');
const crumbs = [
  { name: ui('crumb.home'), path: localizePath('', locale) },
  { name: ui('nav.reputations'), path: reputationPath(locale) },
];
const jsonLd = { '@context': 'https://schema.org', ...breadcrumbJsonLd(crumbs, Astro.site) };
---

<BaseLayout locale={locale} title={title} description={t('description')}>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="wf-reppage">
    <header class="wf-ghead">
      <div class="wf-ghead__main">
        <h1 class="wf-ghead__title">{title}</h1>
      </div>
      {updated && <p class="wf-ghead__count">{t('count', { n: factions.length, date: longDate(updated, locale) })}</p>}
    </header>

    {groups.map((group) => (
      <section class="wf-repgroup" aria-labelledby={groups.length > 1 ? `wf-rep-${group.key}` : undefined}>
        {groups.length > 1 && <h2 class="wf-glabel" id={`wf-rep-${group.key}`}>{groupTitle[group.key]}</h2>}
        <ul class="wf-reps">
          {group.items.map((faction) => (
            <li class="wf-rep">
              <div class="wf-rep__top">
                <p class="wf-rep__name"><a href={faction.href}>{faction.data.faction}</a></p>
                <p class="wf-rep__range">{t('range', { start: standingNames[faction.data.start], cap: standingNames[faction.data.cap] })}</p>
              </div>
              <p class="wf-rep__sub">{faction.data.zone}{group.key === 'both' ? '' : ` · ${side[faction.data.side]}`}</p>
              <p class="wf-rep__rewards"><span class="wf-sr">{t('rewards')}: </span>{faction.data.rewards}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .wf-reppage { padding-block: 6px 40px; }
  .wf-repgroup { margin-top: 20px; }
  .wf-repgroup + .wf-repgroup { margin-top: 26px; }

  .wf-reps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wf-rep {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding: 10px 13px;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-card-sm, 10px);
    background: var(--wf-raised);
    transition: var(--wf-transition);
  }
  .wf-rep:hover { border-color: var(--wf-accent-deep); box-shadow: var(--wf-glow-card); }

  .wf-rep__top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .wf-rep__name { min-width: 0; font-family: var(--wf-serif); font-weight: 600; font-size: 15.5px; line-height: 1.25; color: var(--wf-ink); }
  .wf-rep__name a { color: inherit; }
  .wf-rep__name a::after { content: ''; position: absolute; inset: 0; }
  .wf-rep:hover .wf-rep__name { color: var(--wf-accent); }
  .wf-rep__range {
    flex: none;
    font-family: var(--wf-display);
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--wf-accent-bright);
  }
  .wf-rep__sub { font-size: 12px; color: var(--wf-label); }
  .wf-rep__rewards {
    font-size: 13px;
    line-height: 1.4;
    color: var(--wf-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
