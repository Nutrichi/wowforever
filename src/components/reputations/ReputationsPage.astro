---
/*
 * REPUTATIONS op /reputations/ (PROJECT_SPEC.md §5, handoff §7.5).
 *
 * Alleen voor WoW Forever (Nutri, 15 september 2026), dus zonder era-rij. In
 * groepen: eerst de facties voor iedereen, dan Alliance, dan Horde. Sinds
 * 19 oktober 2026 (Nutri: "too big, it need to be more reputations on 1 page")
 * een raster van compacte kaarten: naam, standing van tot, zone en twee regels
 * beloningen. Hoe je farmt staat op de pagina van de factie; de inleiding is weg.
 *
 * De balk met een "community average" en het snelheidslabel uit de handoff
 * staan er bewust niet: daar bestaan geen cijfers voor (SCHRIJFSTIJL.md).
 */
import type { Locale } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { standingNames } from '../../config/reputations';
import { getReputations, reputationPath, reputationsUpdated } from '../../lib/reputations';
import { repT } from '../../i18n/reputations';
import { longDate } from '../../lib/date';
import { breadcrumbJsonLd } from '../../lib/structured-data';
import '../../styles/guides.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = repT(locale);
const ui = useTranslations(locale);
const factions = await getReputations(locale);
const updated = await reputationsUpdated();
const side = { alliance: t('sideAlliance'), horde: t('sideHorde'), both: t('sideBoth') };
const groupTitle = { both: t('groupBoth'), alliance: t('groupAlliance'), horde: t('groupHorde') };
const groups = (['both', 'alliance', 'horde'] as const)
  .map((key) => ({ key, items: factions.filter((faction) => faction.data.side === key) }))
  .filter((group) => group.items.length > 0);

const title = t('title');
const HEAD: Record<Locale, Record<'faction' | 'side' | 'zone' | 'standing' | 'all' | 'filter', string>> = {
  en: { faction: 'Faction', side: 'Side', zone: 'Zone', standing: 'Standing', all: 'All', filter: 'Filter by side' },
  nl: { faction: 'Factie', side: 'Kant', zone: 'Zone', standing: 'Reputatie', all: 'Alle', filter: 'Filter op kant' },
  fr: { faction: 'Faction', side: 'Camp', zone: 'Zone', standing: 'Réputation', all: 'Toutes', filter: 'Filtrer par camp' },
  es: { faction: 'Facción', side: 'Bando', zone: 'Zona', standing: 'Reputación', all: 'Todas', filter: 'Filtrar por bando' },
  it: { faction: 'Fazione', side: 'Schieramento', zone: 'Zona', standing: 'Reputazione', all: 'Tutte', filter: 'Filtra per schieramento' },
  de: { faction: 'Fraktion', side: 'Seite', zone: 'Zone', standing: 'Ruf', all: 'Alle', filter: 'Nach Seite filtern' },
};
const H = HEAD[locale];
const crumbs = [
  { name: ui('crumb.home'), path: localizePath('', locale) },
  { name: ui('nav.reputations'), path: reputationPath(locale) },
];
const jsonLd = { '@context': 'https://schema.org', ...breadcrumbJsonLd(crumbs, Astro.site) };
---

<BaseLayout locale={locale} title={title} description={t('description')}>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="wf-reppage">
    <header class="wf-ghead">
      <div class="wf-ghead__main">
        <h1 class="wf-ghead__title">{title}</h1>
      </div>
    </header>

    {/* One compact table instead of a card with a reward text per faction (Nutri, 18 November 2026:
        "too much text on the main page"). The rewards stay on the page of each faction. */}
    <nav class="wf-repfilter" aria-label={H.filter} data-pagefind-ignore>
      {(['all', 'both', 'alliance', 'horde'] as const).map((key) => (
        <button type="button" class="wf-gchip" data-rep-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>
          {key === 'all' ? H.all : side[key]}
        </button>
      ))}
    </nav>
    <div class="wf-gprose">
      <table class="wf-reptable">
        <thead>
          <tr><th>{H.faction}</th><th>{H.side}</th><th>{H.zone}</th><th>{H.standing}</th></tr>
        </thead>
        <tbody>
          {groups.flatMap((group) => group.items).map((faction) => (
            <tr data-side={faction.data.side}>
              <td><a href={faction.href}>{faction.data.faction}</a></td>
              <td>{side[faction.data.side]}</td>
              <td>{faction.data.zone}</td>
              <td>{t('range', { start: standingNames[faction.data.start], cap: standingNames[faction.data.cap] })}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-rep-filter]')) {
        button.addEventListener('click', () => {
          const key = button.dataset.repFilter;
          document.querySelectorAll('[data-rep-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
          document.querySelectorAll<HTMLTableRowElement>('.wf-reptable tbody tr').forEach((row) => {
            row.hidden = key !== 'all' && row.dataset.side !== key;
          });
        });
      }
    </script>
  </div>
</BaseLayout>

<style>
  .wf-repfilter { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 16px; }
  .wf-repfilter .wf-gchip { cursor: pointer; }
  .wf-repfilter .wf-gchip[aria-pressed='true'] { border-color: var(--wf-accent); color: var(--wf-accent); }
  .wf-reptable td:first-child a { font-weight: 600; }

  .wf-reppage { padding-block: 6px 40px; }
  .wf-repgroup { margin-top: 20px; }
  .wf-repgroup + .wf-repgroup { margin-top: 26px; }

  .wf-reps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wf-rep {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding: 10px 13px;
    border: 1px solid var(--wf-border);
    border-radius: var(--wf-r-card-sm, 10px);
    background: var(--wf-raised);
    transition: var(--wf-transition);
  }
  .wf-rep:hover { border-color: var(--wf-accent-deep); box-shadow: var(--wf-glow-card); }

  .wf-rep__top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .wf-rep__name { min-width: 0; font-family: var(--wf-serif); font-weight: 600; font-size: 15.5px; line-height: 1.25; color: var(--wf-ink); }
  .wf-rep__name a { color: inherit; }
  .wf-rep__name a::after { content: ''; position: absolute; inset: 0; }
  .wf-rep:hover .wf-rep__name { color: var(--wf-accent); }
  .wf-rep__range {
    flex: none;
    font-family: var(--wf-display);
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--wf-accent-bright);
  }
  .wf-rep__sub { font-size: 12px; color: var(--wf-label); }
  .wf-rep__rewards {
    font-size: 13px;
    line-height: 1.4;
    color: var(--wf-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
