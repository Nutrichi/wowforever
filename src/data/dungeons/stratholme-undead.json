 "cards": {
  "12833": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_scroll_03.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q3\" href=\"https://www.wowhead.com/forever/item=12833\">Plans: Hammer of the Titans</a><span class=\"wf-item__line wf-item__meta\">Item Level 63</span><span class=\"wf-item__line\">Requires Blacksmithing (300)</span><span class=\"wf-item__line\">Requires Master Hammersmith</span><span class=\"wf-item__line wf-item__use\">Use: Teaches you how to make a Hammer of the Titans.</span><span class=\"wf-item__line\">Hammer of the Titans</span><span class=\"wf-item__line wf-item__meta\">Item Level 63</span><span class=\"wf-item__line\">Binds when equipped</span><span class=\"wf-item__row\"><span>Two-Hand</span><span>Mace</span></span><span class=\"wf-item__row\"><span>163 - 246 Damage</span><span>Speed 3.80</span></span><span class=\"wf-item__line\">(53.82 damage per second)</span><span class=\"wf-item__line\">+15 Strength</span><span class=\"wf-item__line\">Durability 100 / 100</span><span class=\"wf-item__line\">Requires Level 58</span><span class=\"wf-item__line wf-item__use\">Chance on hit: Stuns target for 3 sec.</span><span class=\"wf-item__line\">Requires Thorium Bar (50), Arcanite Bar (15), Guardian Stone (4), Enchanted Leather (6), Essence of Earth (10)</span></div></div>",
  "13209": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_misc_armorkit_18.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q3\" href=\"https://www.wowhead.com/forever/item=13209\">Seal of the Dawn</a><span class=\"wf-item__line wf-item__meta\">Item Level 61</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__line\">Unique-Equipped: Trinket of the Dawn (1)</span><span class=\"wf-item__row\"><span>Trinket</span><span></span></span><span class=\"wf-item__line wf-item__use\">Equip: +78 Attack Power against Undead.</span></div></div>",
  "13216": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_helmet_06.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q2\" href=\"https://www.wowhead.com/forever/item=13216\">Crown of the Penitent</a><span class=\"wf-item__line wf-item__meta\">Item Level 61</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__row\"><span>Head</span><span>Cloth</span></span><span class=\"wf-item__line\">64 Armor</span><span class=\"wf-item__line\">+20 Intellect</span><span class=\"wf-item__line\">Restores +6 mana per 5 sec.</span><span class=\"wf-item__line\">Durability 45 / 45</span><span class=\"wf-item__line wf-item__use\">Equip: Increases healing done by up to 10 and damage done by up to 3 for all magical spells and effects.</span></div></div>",
