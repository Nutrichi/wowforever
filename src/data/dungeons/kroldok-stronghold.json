 "cards": {
  "279480": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_mace_04.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q3\" href=\"https://www.wowhead.com/forever/item=279480\">Bigger Rock on Bigger Stick</a><span class=\"wf-item__line wf-item__meta\">Item Level 47</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__row\"><span>Two-Hand</span><span>Mace</span></span><span class=\"wf-item__row\"><span>112 - 168 Damage</span><span>Speed 3.40</span></span><span class=\"wf-item__line\">(41.18 damage per second)</span><span class=\"wf-item__line\">+14 Strength</span><span class=\"wf-item__line\">Durability 100 / 100</span><span class=\"wf-item__line wf-item__use\">Chance on hit: Bash the target in the face, causing 14 Physical damage every 2 sec for 20 sec.</span><span class=\"wf-item__line wf-item__meta\">\"That's more like it!\"</span></div></div>",
  "279852": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_hammer_09.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q3\" href=\"https://www.wowhead.com/forever/item=279852\">Rock on Stick</a><span class=\"wf-item__line wf-item__meta\">Item Level 47</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__row\"><span>One-Hand</span><span>Mace</span></span><span class=\"wf-item__row\"><span>57 - 107 Damage</span><span>Speed 2.60</span></span><span class=\"wf-item__line\">(31.54 damage per second)</span><span class=\"wf-item__line\">+4 Strength</span><span class=\"wf-item__line\">Durability 90 / 90</span><span class=\"wf-item__line wf-item__use\">Chance on hit: Bash the target in the face, causing 7 Physical damage every 2 sec for 20 sec.</span><span class=\"wf-item__line wf-item__meta\">\"Need bigger rock. Maybe bigger stick too?\"</span></div></div>",
  "279853": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_staff_22.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q3\" href=\"https://www.wowhead.com/forever/item=279853\">Stick No Rock</a><span class=\"wf-item__line wf-item__meta\">Item Level 47</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__row\"><span>Two-Hand</span><span>Staff</span></span><span class=\"wf-item__row\"><span>80 - 121 Damage</span><span>Speed 3.30</span></span><span class=\"wf-item__line\">(30.45 damage per second)</span><span class=\"wf-item__line\">+10 Strength</span><span class=\"wf-item__line\">+18 Spirit</span><span class=\"wf-item__line\">Restores +22 health per 5 sec.</span><span class=\"wf-item__line\">Durability 100 / 100</span><span class=\"wf-item__line wf-item__use\">Equip: Increases healing done by up to 101 and damage done by up to 33 for all magical spells and effects.</span><span class=\"wf-item__line wf-item__meta\">\"Need rock.\"</span></div></div>"
