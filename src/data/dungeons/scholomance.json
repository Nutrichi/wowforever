 "cards": {
  "14514": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_scroll_03.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q4\" href=\"https://www.wowhead.com/forever/item=14514\">Pattern: Robe of the Void</a><span class=\"wf-item__line wf-item__meta\">Item Level 62</span><span class=\"wf-item__line\">Requires Tailoring (295)</span><span class=\"wf-item__line wf-item__use\">Use: Teaches you how to sew a Robe of the Void.</span><span class=\"wf-item__line\">Robe of the Void</span><span class=\"wf-item__line wf-item__meta\">Item Level 62</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__row\"><span>Chest</span><span>Cloth</span></span><span class=\"wf-item__line\">96 Armor</span><span class=\"wf-item__line\">+10 Stamina</span><span class=\"wf-item__line\">+9 Intellect</span><span class=\"wf-item__line\">Durability 100 / 100Classes: WarlockRequires Level 57</span><span class=\"wf-item__line wf-item__use\">Equip: Increases damage and healing done by magical spells and effects by up to 46.</span><span class=\"wf-item__line wf-item__use\">Use: Heal your pet for 450 to 750. (10 Min Cooldown)</span><span class=\"wf-item__line\">Requires Bolt of Runecloth (12), Demonic Rune (20), Felcloth (40), Essence of Fire (8), Essence of Undeath (8), Rune Thread (2), Viridian Dye (10)</span></div></div>",
  "14525": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_gauntlets_29.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q3\" href=\"https://www.wowhead.com/forever/item=14525\">Boneclenched Gauntlets</a><span class=\"wf-item__line wf-item__meta\">Item Level 62</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__row\"><span>Hands</span><span>Plate</span></span><span class=\"wf-item__line\">404 Armor</span><span class=\"wf-item__line\">+16 Strength</span><span class=\"wf-item__line\">+15 Stamina</span><span class=\"wf-item__line\">Durability 45 / 45</span><span class=\"wf-item__line\">Requires Level 57</span><span class=\"wf-item__line wf-item__use\">Equip: Increased Defense +7.</span></div></div>",
  "14624": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_chest_chain_15.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q3\" href=\"https://www.wowhead.com/forever/item=14624\">Deathbone Chestplate</a><span class=\"wf-item__line wf-item__meta\">Item Level 61</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__row\"><span>Chest</span><span>Plate</span></span><span class=\"wf-item__line\">637 Armor</span><span class=\"wf-item__line\">+16 Stamina</span><span class=\"wf-item__line\">+11 Intellect</span><span class=\"wf-item__line\">Durability 135 / 135</span><span class=\"wf-item__line\">Requires Level 56</span><span class=\"wf-item__line wf-item__use\">Equip: Increased Defense +17.</span><span class=\"wf-item__line wf-item__setname\">Deathbone Guardian (0/5)</span><span class=\"wf-item__line wf-item__set\">(2) Set: Increased Defense +3.</span><span class=\"wf-item__line wf-item__set\">(3) Set: Grants a chance when struck in combat to increase damage and healing done by magical spells and effects by up to 70 for 10 sec. (Proc chance: 15%, 1m cooldown)</span><span class=\"wf-item__line wf-item__set\">(4) Set: +5 All Resistances.</span><span class=\"wf-item__line wf-item__set\">(5) Set: Reduces the chance for your attacks to be dodged or parried by 2%.</span></div></div>",
  "16677": "<div class=\"wf-item\"><img class=\"wf-item__icon\" src=\"/wh/inv_helmet_24.jpg\" alt=\"\" width=\"36\" height=\"36\" loading=\"lazy\"><div class=\"wf-item__tip\"><a class=\"wf-item__name wf-q3\" href=\"https://www.wowhead.com/forever/item=16677\">Beaststalker's Cap</a><span class=\"wf-item__line wf-item__meta\">Item Level 62</span><span class=\"wf-item__line\">Binds when picked up</span><span class=\"wf-item__row\"><span>Head</span><span>Mail</span></span><span class=\"wf-item__line\">297 Armor</span><span class=\"wf-item__line\">+20 Agility</span><span class=\"wf-item__line\">+20 Stamina</span><span class=\"wf-item__line\">+13 Intellect</span><span class=\"wf-item__line\">+6 Spirit</span><span class=\"wf-item__line\">Durability 70 / 70</span><span class=\"wf-item__line\">Requires Level 57</span><span class=\"wf-item__line wf-item__setname\">Beaststalker Armor (0/8)</span><span class=\"wf-item__line wf-item__set\">(2) Set: +8 All Resistances.</span><span class=\"wf-item__line wf-item__set\">(3) Set: +30 Attack Power.</span><span class=\"wf-item__line wf-item__set\">(4) Set: When struck in combat, has a 8% chance to remove a Root effect from yourself. Can only occur once every 60 sec. (Proc chance: 8%, 1m cooldown)</span><span class=\"wf-item__line wf-item__set\">(5) Set: Your melee and ranged autoattacks have a 5% chance to energize you for 200 mana. (Proc chance: 5%)</span><span class=\"wf-item__line wf-item__set\">(6) Set: Restores 8 mana per 5 sec.</span></div></div>",
