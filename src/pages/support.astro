        line-height: 1.65;
      }
      h1 { font-size: 1.6rem; line-height: 1.25; margin: 0 0 1rem; }
      h2 { font-size: 1.1rem; line-height: 1.3; margin: 1.8rem 0 .4rem; }
      p { margin: 0 0 .75rem; }
      ul { margin: 0 0 .75rem; padding-left: 1.25rem; }
