---
/*
 * De 404-pagina. GitHub Pages toont dist/404.html voor elk adres dat niet
 * bestaat, in welke taal ook; daarom staat ze in het Engels, met de weg terug
 * naar de homepage in elke taal.
 *
 * Noindex, maar wel met de GA4-tag: zo toont Analytics welke adressen stuk
 * zijn. Het is de enige pagina waar noindex en de tag samengaan (§11.1).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeNames, locales } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t('notFound.title')}
  description={t('notFound.text')}
  index={false}
  analytics
  langPath="/"
>
  <section class="wf-404">
    <p class="wf-404__code" aria-hidden="true">404</p>
    <h1 class="wf-404__title">{t('notFound.title')}</h1>
    <p class="wf-404__text">{t('notFound.text')}</p>

    <a class="wf-404__home" href={localizePath('', locale)}>{t('notFound.home')}</a>

    <ul class="wf-404__langs">
      {locales.map((code) => (
        <li><a href={localizePath('', code)} lang={code}>{localeNames[code]}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .wf-404 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 520px;
    margin: 0 auto;
    padding: 40px 0 56px;
    text-align: center;
  }

  /* Het getal in het verloop van de spine; het enige grote accent op de pagina. */
  .wf-404__code {
    font-family: var(--wf-serif);
    font-weight: 600;
    font-size: 120px;
    line-height: .95;
    background: var(--wf-spine-h);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .wf-404__title {
    font-size: 34px;
    line-height: 1.1;
    text-shadow: var(--wf-glow-h1);
  }

  .wf-404__text {
    font-size: 16px;
    line-height: 1.65;
    color: var(--wf-muted);
  }

  .wf-404__home {
    margin-top: 10px;
    padding: 10px 28px;
    border-radius: var(--wf-r-pill);
    background: var(--wf-button);
    color: var(--wf-button-ink);
    box-shadow: var(--wf-glow-primary);
    font-family: var(--wf-display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: .12em;
  }

  .wf-404__langs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 16px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    color: var(--wf-muted);
  }

  .wf-404__langs a:hover { color: var(--wf-ink); }

  @media (max-width: 899px) {
    .wf-404 { padding: 24px 0 36px; }
    .wf-404__code { font-size: 92px; }
    .wf-404__title { font-size: 28px; }
  }
</style>
