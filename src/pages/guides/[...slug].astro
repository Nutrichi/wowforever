---
/*
 * /guides/ en de pagina's eronder, in het Engels (PROJECT_SPEC.md §4.4).
 *
 * Een gids is geen nieuws: hij veroudert niet na een week en hij hoort niet in
 * de feed. Hij staat naast de zeven tabs, net als /compare/, en wordt bereikt
 * vanuit de post die hem nodig heeft. Een pagina bestaat alleen als er een
 * Engelse tekst voor is (§4.2).
 */
import SitePage from '../../components/pages/SitePage.astro';
import { pageSlugs } from '../../lib/pages';

export async function getStaticPaths() {
  return (await pageSlugs('guides')).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<SitePage locale="en" pageKey={slug ? `guides/${slug}` : 'guides'} />
