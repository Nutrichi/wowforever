---
/*
 * De homepage in het Engels, op `/`: NEWS (handoff §7.1). De vijf andere talen
 * komen uit [lang]/index.astro; de inhoud staat in HomeGrid, zodat er niets
 * dubbel is.
 *
 * Het uitgelichte artikel staat óók in de lijst: de lijst is het volledige
 * archief. De categoriefilters staan onder de kop van de lijst.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeGrid from '../components/HomeGrid.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostList from '../components/PostList.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { getPosts, pickFeatured } from '../lib/posts';
import { featuredPreload } from '../lib/post-image';
import { websiteJsonLd } from '../lib/structured-data';
import { useTranslations } from '../i18n/utils';

const locale = 'en' as const;
const t = useTranslations(locale);
const posts = await getPosts(locale);
const featured = pickFeatured(posts);

/* Het uitgelichte beeld is de LCP van de homepage: vooraf laden in de head. */
const preload = featured?.image ? await featuredPreload(featured.image) : undefined;

/* Gestructureerde data; hier en niet in de script-tag, want daar kent Astro zichzelf niet. */
const jsonLd = websiteJsonLd(locale, Astro.site);
---

<BaseLayout locale={locale}>
  {preload && (
    <link slot="head" rel="preload" as="image" href={preload.href} imagesrcset={preload.imagesrcset}
      imagesizes={preload.imagesizes} fetchpriority="high" />
  )}
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />
  <!--
    Geen zichtbare paginakop: de feed begint meteen. De titel staat er alleen
    voor schermlezers en zoekmachines, want elke pagina heeft één h1 (§17).
    Zo doet FeedPage.astro het ook.
  -->
  <h1 class="wf-sr">{t('site.homeTitle')}</h1>
  <HomeGrid
    locale={locale}
    hasFeatured={!!featured}
    hasList={posts.length > 0}
  >
    {featured && <FeaturedPost slot="featured" post={featured} locale={locale} />}
    {posts.length > 0 && (
      <Fragment slot="list">
        <CategoryFilter locale={locale} />
        <PostList posts={posts} locale={locale} />
      </Fragment>
    )}
  </HomeGrid>
</BaseLayout>
