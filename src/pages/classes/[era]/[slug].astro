---
/* Eén gids onder CLASSES in het Engels: /classes/<era>/<slug>/, of een spec of gids van een class in Forever: /classes/druid/balance/. */
import GuideDetailPage from '../../../components/guides/GuideDetailPage.astro';
import SitePage from '../../../components/pages/SitePage.astro';
import { getGuide, getGuides } from '../../../lib/guides';
import { pageSlugs } from '../../../lib/pages';
import type { GuideEra } from '../../../config/guides';

export async function getStaticPaths() {
  const eraGuides = (await getGuides('classes', 'en')).map((guide) => ({ params: { era: guide.era, slug: guide.slug } }));
  const classPages = (await pageSlugs('classes')).filter((s): s is string => !!s && s.split('/').length === 2)
    .map((s) => ({ params: { era: s.split('/')[0], slug: s.split('/')[1] } }));
  return [...eraGuides, ...classPages];
}

const { era, slug } = Astro.params;
const guide = await getGuide('classes', era as GuideEra, slug!, 'en');
---

{guide ? <GuideDetailPage locale="en" guide={guide} /> : <SitePage locale="en" pageKey={`classes/${era}/${slug}`} />}
