---
/* De Forever-hub in de vijf niet-standaardtalen: /nl/forever/ enzovoort. */
import SitePage from '../../components/pages/SitePage.astro';
import { otherLocales } from '../../lib/posts';
import type { Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return otherLocales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<SitePage locale={locale} pageKey="forever" />
