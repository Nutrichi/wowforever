---
/* REPUTATIONS in de vijf niet-standaardtalen: /nl/reputations/ enzovoort. */
import ReputationsPage from '../../../components/reputations/ReputationsPage.astro';
import { otherLocales } from '../../../lib/posts';
import type { Locale } from '../../../i18n/ui';

