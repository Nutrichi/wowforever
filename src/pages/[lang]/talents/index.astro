---
/* TALENTS in de vijf andere talen, op /<taal>/talents/. */
import type { GetStaticPaths } from 'astro';
import TalentsIndex from '../../../components/talents/TalentsIndex.astro';
import { otherLocales } from '../../../lib/posts';
import type { Locale } from '../../../i18n/ui';

export const getStaticPaths: GetStaticPaths = () =>
  otherLocales.map((lang) => ({ params: { lang } }));

const locale = Astro.params.lang as Locale;
---

<TalentsIndex locale={locale} />
