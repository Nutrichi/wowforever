---
/* De Class Picker in de vijf andere talen, op /<taal>/class-picker/. */
import type { GetStaticPaths } from 'astro';
import ClassPicker from '../../../components/talents/ClassPicker.astro';
import { otherLocales } from '../../../lib/posts';
import type { Locale } from '../../../i18n/ui';

export const getStaticPaths: GetStaticPaths = () =>
  otherLocales.map((lang) => ({ params: { lang } }));

const locale = Astro.params.lang as Locale;
---

<ClassPicker locale={locale} />
