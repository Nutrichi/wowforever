---
/* De levelbuild van een class, in de vijf andere talen. */
import type { GetStaticPaths } from 'astro';
import LevelingBuild from '../../../components/talents/LevelingBuild.astro';
import { type LevelingBuild as Build, levelingBuilds } from '../../../lib/leveling';
import { otherLocales } from '../../../lib/posts';
import type { Locale } from '../../../i18n/ui';

export const getStaticPaths: GetStaticPaths = () =>
  otherLocales.flatMap((lang) =>
    levelingBuilds().map((build) => ({ params: { lang, class: build.id }, props: { build } })));

const locale = Astro.params.lang as Locale;
const { build } = Astro.props as { build: Build };
---

<LevelingBuild locale={locale} build={build} />
