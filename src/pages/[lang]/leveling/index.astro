---
/* De levelbuilds, in de vijf andere talen. */
import type { GetStaticPaths } from 'astro';
import LevelingIndex from '../../../components/talents/LevelingIndex.astro';
import { otherLocales } from '../../../lib/posts';
import type { Locale } from '../../../i18n/ui';

export const getStaticPaths: GetStaticPaths = () => otherLocales.map((lang) => ({ params: { lang } }));

const locale = Astro.params.lang as Locale;
---

<LevelingIndex locale={locale} />
