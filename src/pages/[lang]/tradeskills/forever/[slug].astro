---
/*
 * De Forever-gidsen onder TRADESKILLS in de vijf niet-standaardtalen.
 * Zie de Engelse route voor het waarom.
 */
import SitePage from '../../../../components/pages/SitePage.astro';
import { pageSlugs } from '../../../../lib/pages';
import { defaultLocale, locales, type Locale } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const slugs = (await pageSlugs('tradeskills/forever')).filter((slug): slug is string => !!slug);
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as Locale;
const { slug } = Astro.params;
---

<SitePage locale={lang} pageKey={`tradeskills/forever/${slug}`} />
