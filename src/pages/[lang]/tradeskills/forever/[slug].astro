---
/*
 * Het overzicht van een Forever-tradeskill in de vijf niet-standaardtalen.
 * Zie de Engelse route voor het waarom.
 */
import SitePage from '../../../../components/pages/SitePage.astro';
import TradeskillPage from '../../../../components/tradeskills/TradeskillPage.astro';
import { pageSlugs } from '../../../../lib/pages';
import { tsSkills } from '../../../../lib/tradeskills-forever';
import { defaultLocale, locales, type Locale } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const pages = (await pageSlugs('tradeskills/forever')).filter((slug): slug is string => !!slug);
  const slugs = [...new Set([...pages, ...tsSkills()])];
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug }, props: { page: pages.includes(slug) } })));
}

const lang = Astro.params.lang as Locale;
const { slug } = Astro.params;
const { page } = Astro.props;
---

{page
  ? <SitePage locale={lang} pageKey={`tradeskills/forever/${slug}`} />
  : <TradeskillPage locale={lang} skill={slug!} kind="overview" />}
