---
/* De recepten van een Forever-tradeskill in de vijf andere talen. */
import TradeskillPage from '../../../../../components/tradeskills/TradeskillPage.astro';
import { hasRecipes, tsSkills } from '../../../../../lib/tradeskills-forever';
import { defaultLocale, locales, type Locale } from '../../../../../i18n/ui';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((lang) => tsSkills().filter(hasRecipes).map((slug) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as Locale;
const { slug } = Astro.params;
---

<TradeskillPage locale={lang} skill={slug!} kind="recipes" />
