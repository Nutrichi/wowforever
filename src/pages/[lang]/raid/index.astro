---
/* De raidplanner in de vijf andere talen, op /<taal>/raid/. */
import type { GetStaticPaths } from 'astro';
import RaidPlanner from '../../../components/talents/RaidPlanner.astro';
import { otherLocales } from '../../../lib/posts';
import type { Locale } from '../../../i18n/ui';

export const getStaticPaths: GetStaticPaths = () =>
  otherLocales.map((lang) => ({ params: { lang } }));

const locale = Astro.params.lang as Locale;
---

<RaidPlanner locale={locale} />
