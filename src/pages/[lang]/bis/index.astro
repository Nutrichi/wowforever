---
/*
 * BIS in de vijf niet-standaardtalen: /nl/bis/ enzovoort. Engels staat in
 * ../../bis/index.astro.
 */
import BisEraPage from '../../../components/bis/BisEraPage.astro';
import { defaultLocale, locales, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== defaultLocale).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<BisEraPage locale={locale} era="forever" />
