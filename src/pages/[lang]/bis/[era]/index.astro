---
/*
 * De pagina van één era onder BIS in de vijf niet-standaardtalen:
 * /nl/bis/tbc/ enzovoort.
 */
import BisEraPage from '../../../../components/bis/BisEraPage.astro';
import type { EraKey } from '../../../../config/eras';
import { bisEras } from '../../../../config/bis';
import { defaultLocale, locales, type Locale } from '../../../../i18n/ui';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((lang) => bisEras.map((era) => ({ params: { lang, era } })));
}

const locale = Astro.params.lang as Locale;
const era = Astro.params.era as EraKey;
---

<BisEraPage locale={locale} era={era} />
