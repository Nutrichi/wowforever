---
/*
 * Eén BiS-lijst in de vijf niet-standaardtalen: /nl/bis/<era>/<fase>/<slug>/.
 */
import BisDetailPage from '../../../../../components/bis/BisDetailPage.astro';
import BisSoonPage from '../../../../../components/bis/BisSoonPage.astro';
import { getBisLists, soonSpecs, type BisList } from '../../../../../lib/bis';
import { defaultLocale, locales, type Locale } from '../../../../../i18n/ui';

export function getStaticPaths() {
  const lists = getBisLists();
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((lang) => lists.map((list) => ({
      params: { lang, era: list.era, phase: list.phase, slug: list.slug },
      props: { list },
    })).concat(soonSpecs().map((soon) => ({
      params: { lang, era: 'forever', phase: 'preraid', slug: soon.slug },
      props: { soon },
    })) as never[]));
}

const locale = Astro.params.lang as Locale;
const { list, soon } = Astro.props as { list?: BisList; soon?: { class: string; spec: string } };
---

{list ? <BisDetailPage locale={locale} list={list} /> : <BisSoonPage locale={locale} cls={soon!.class} spec={soon!.spec} />}
